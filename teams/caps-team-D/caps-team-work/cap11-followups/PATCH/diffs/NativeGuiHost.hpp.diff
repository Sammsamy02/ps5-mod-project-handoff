+        // [FU-DPI] Sharp text at any screen density. This backend is a legacy
+        // ImGui renderer (no ImGuiBackendFlags_RendererHasTextures), so the font
+        // atlas only holds the sizes baked into it; any other size is a scaled
+        // bitmap (before: the 13 px default font drawn at 20 units x 2.0 on a 4K
+        // screen = 3x blow-up). Bake the default font at exactly the size it is
+        // drawn at (style FontSizeBase x FontScaleMain x FontScaleDpi, rounded
+        // the way ImGui rounds it) and at `density` texels per unit, so each
+        // glyph texel is one screen pixel. Public 1.92.1 API only; the font
+        // object, its LegacySize and any font a mod added stay untouched (the
+        // bake is added, nothing is cleared). Game thread, between frames (the
+        // atlas is unlocked outside NewFrame..Render). Refreshes the CPU copy of
+        // the atlas and drops the uploaded texture so frame() uploads it again.
+        auto bake_font(float density) -> bool
+        {
+            auto skip = [&](const std::string& why) {
+                m_backend.log(MBM_LOG_WARNING, "[GUI] sharp-font bake for density " + std::to_string(density) + " skipped (" + why +
+                                                       "); text is drawn from the existing bake (softer)");
+                return false;
+            };
+            ImGuiIO& io = ImGui::GetIO();
+            ImFontAtlas* atlas = io.Fonts;
+            if (!atlas || atlas->Locked || atlas->Fonts.Size == 0) return skip("no unlocked font atlas");
+            ImFont* font = io.FontDefault ? io.FontDefault : atlas->Fonts[0];
+            const ImGuiStyle& st = ImGui::GetStyle();
+            const float base = st.FontSizeBase > 0.0f ? st.FontSizeBase : (font->LegacySize > 0.0f ? font->LegacySize : 13.0f);
+            const float size = ImGui::GetRoundedFontSize(base * st.FontScaleMain * st.FontScaleDpi);
+            if (!(size >= 1.0f && size <= 256.0f)) return skip("font size " + std::to_string(size) + " out of range");
+            // [review #2] Bound the work: count every codepoint of every font
+            // source in the atlas (a rebuild after a grow preloads all fonts),
+            // and estimate the texels this bake adds. Above either bound the
+            // extra bake is skipped (one warning, the old scaled text stays).
+            size_t codepoints = 0;
+            for (const ImFontConfig& src : atlas->Sources)
+                for (const ImWchar* r = src.GlyphRanges ? src.GlyphRanges : atlas->GetGlyphRangesDefault(); r[0]; r += 2)
+                    codepoints += r[1] >= r[0] ? static_cast<size_t>(r[1] - r[0]) + 1 : 0;
+            const double px = static_cast<double>(size) * density;
+            const double texels = static_cast<double>(codepoints) * px * px;
+            if (codepoints > m_cfg.max_bake_codepoints || texels > static_cast<double>(m_cfg.max_bake_texels))
+                return skip(std::to_string(codepoints) + " codepoints at " + std::to_string(static_cast<int>(px)) + " px exceed the bound");
+            ImFontBaked* baked = font->GetFontBaked(size, density); // density explicit: CurrentRasterizerDensity is set after the rebuild below
+            if (!baked) return skip("GetFontBaked returned nothing");
+            // Same preload ImGui does for legacy renderers at build time
+            // (ImFontAtlasBuildLegacyPreloadAllGlyphRanges), for this one size.
+            if (font->FallbackChar != 0) baked->FindGlyph(font->FallbackChar);
+            if (font->EllipsisChar != 0) baked->FindGlyph(font->EllipsisChar);
+            for (ImFontConfig* src : font->Sources)
+                for (const ImWchar* r = src->GlyphRanges ? src->GlyphRanges : atlas->GetGlyphRangesDefault(); r[0]; r += 2)
+                    for (unsigned int c = r[0]; c <= r[1] && c <= IM_UNICODE_CODEPOINT_MAX; ++c) baked->FindGlyph(static_cast<ImWchar>(c));
+            unsigned char* pixels{};
+            int w{}, h{};
+            // Rebuilt ("built" again) if the new glyphs grew the texture. Its legacy
+            // preload re-bakes LegacySize at the font's CURRENT density, which is
+            // still the previous one here (already baked: nothing extra) [review #3].
+            atlas->GetTexDataAsAlpha8(&pixels, &w, &h);
+            if (!pixels || w <= 0 || h <= 0) return skip("atlas pixels unavailable");
+            // In a legacy atlas the in-frame lookup uses the font's current
+            // density (ImGui only updates it for RendererHasTextures backends):
+            // from now on the default size hits the new bake exactly.
+            font->CurrentRasterizerDensity = density;
+            // A grown atlas leaves the old texture queued for destruction; it
+            // carries our old texture id, so ImGui would keep it forever
+            // (a legacy renderer never confirms a destroy). Clear the id: ImGui
+            // frees that CPU copy at the next NewFrame.
+            for (ImTextureData* t : atlas->TexList)
+                if (t != atlas->TexData && t->WantDestroyNextFrame) t->SetTexID(ImTextureID_Invalid);
+            m_atlas_alpha.assign(pixels, pixels + static_cast<size_t>(w) * h);
+            m_atlas_w = w;
+            m_atlas_h = h;
+            m_atlas_tex = 0; // upload the new atlas (frame() does it next)
+            m_backend.log(MBM_LOG_NORMAL, "[GUI] font baked size=" + std::to_string(static_cast<int>(size)) + " density=" + std::to_string(density) +
+                                                  " atlas=" + std::to_string(w) + "x" + std::to_string(h));
+            return true;
+        }
