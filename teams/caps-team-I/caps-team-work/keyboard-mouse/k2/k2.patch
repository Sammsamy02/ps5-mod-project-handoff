+    namespace detail
+    {
+        constexpr auto make_row_index() -> std::array<int16_t, 256>
+        {
+            std::array<int16_t, 256> index{};
+            for (auto& slot : index) slot = -1;
+            for (size_t i = 0; i < std::size(k_key_rows); ++i) index[static_cast<uint8_t>(k_key_rows[i].key)] = static_cast<int16_t>(i);
+            return index;
+        }
+        constexpr auto rows_unique() -> bool
+        {
+            for (size_t i = 0; i < std::size(k_key_rows); ++i)
+                for (size_t j = i + 1; j < std::size(k_key_rows); ++j)
+                    if (k_key_rows[i].key == k_key_rows[j].key) return false;
+            return true;
+        }
+        inline constexpr std::array<int16_t, 256> k_row_index = make_row_index();
+
+        inline auto steady_now_ns() -> uint64_t
+        {
+            return static_cast<uint64_t>(
+                    std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+        }
+    } // namespace detail
+    static_assert(detail::rows_unique(), "every UE4SS key appears once in the key table");
+
+    inline auto key_table() -> std::span<const KeyRow> { return k_key_rows; }
+    inline auto modifier_table() -> std::span<const ModifierRow> { return k_modifier_rows; }
+    inline auto hid_aliases() -> std::span<const HidAlias> { return k_hid_aliases; }
+
+    // nullptr if the value is not a bindable key
+    inline auto row_for(Key key) -> const KeyRow*
+    {
+        const int16_t i = detail::k_row_index[static_cast<uint8_t>(key)];
+        return i < 0 ? nullptr : &k_key_rows[i];
+    }
+    inline auto fkey_for(Key key) -> const char*
+    {
+        const KeyRow* row = row_for(key);
+        return row ? row->fkey : nullptr;
+    }
+    inline auto key_for_fkey(std::string_view fkey) -> std::optional<Key>
+    {
+        for (const auto& row : k_key_rows)
+            if (row.fkey && fkey == row.fkey) return row.key;
+        return std::nullopt;
+    }
+    inline auto key_for_hid(uint16_t usage) -> std::optional<Key>
+    {
+        if (usage == 0) return std::nullopt;
+        for (const auto& row : k_key_rows)
+            if (row.hid == usage) return row.key;
+        for (const auto& alias : k_hid_aliases)
+            if (alias.hid == usage) return alias.key;
+        return std::nullopt;
+    }
