diff -ruN base/include/Platform/KbmEngineKeys.hpp new/include/Platform/KbmEngineKeys.hpp
--- base/include/Platform/KbmEngineKeys.hpp	1969-12-31 18:00:00
+++ new/include/Platform/KbmEngineKeys.hpp	2026-10-13 21:29:20
@@ -0,0 +1,1198 @@
+#pragma once
+// KbmEngineKeys.hpp -- USB keyboard and mouse for UE4SS key binds on PS5 (capability K2, Team I2).
+//
+// Plain words: the game already owns the USB keyboard and mouse and turns them into Unreal key presses. We open
+// no device. On the game thread the runtime asks the game's own local PlayerController "is key X down?" (its
+// reflected IsInputKeyDown function), only for keys that mods registered, and turns up->down changes into normal
+// UE4SS key events. The controller chords from PS5Pad.ini keep working exactly as before, next to it.
+//
+// This header is ENGINE-FREE (no Unreal header; host-tested in caps-team-I/.../k2/tests):
+//   1. key table          UE4SS Key -> engine key name (Epic's public EKeys names; the live game's name table
+//                         decides at run time, find-only, whether the name exists)
+//   2. KeyStateReader     the engine boundary the sampler uses (game thread only)
+//   3. KeyReflection +    the reflection-checked reader: IsInputKeyDown found BY NAME, its parameter layout
+//      EngineKeyReader    checked by reflection (one by-value `Key` struct parameter holding `FName KeyName`, one
+//                         bool return value; reflected offsets and ParmsSize only), find-only FName lookup with a
+//                         miss cache, controller cache rebuilt on miss with a generation counter. Any failed check
+//                         = Unsupported for good.
+//   4. EngineKeySampler   game thread: once per pump call (at most every 8 ms; nothing at all while no key with an
+//                         engine name is bound), up->down edges into an SPSC ring
+//   5. EngineKeySource    UE4SS update thread: a normal PlatformInputSource that drains the ring
+//   6. CompositeInputSource "Merged": the handler still sees ONE source (pad + engine keys)
+//   7. EngineKeysRuntime  the glue: compose once (failure keeps the supplied source), frame (re-entry guarded),
+//                         retire (teardown: handler shutdown -> pump retirement -> unload)
+// The Unreal binding of KeyReflection and the three C entry points are in candidate/src/KbmEngineKeysRuntime.inc.
+//
+// Rules kept: no new import, no device access, no hook / detour / code patch, no game or mod name, no offset
+// (every layout fact comes from the engine's reflection at run time), fail closed (any failed check switches the
+// engine-keys source off; pad chords are unaffected), bounded cost (only bound keys; 0.25 ms budget with automatic
+// slowdown; modifiers are read only on a frame that has a key edge), nothing throws out of tick() / process_event().
+#include <Input/Handler.hpp>
+#include <Input/KeyDef.hpp>
+#include <Input/PlatformInputSource.hpp>
+#include <Input/RingBuffer.hpp>
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace RC::Platform::Kbm
+{
+    using Input::InputEvent;
+    using Input::Key;
+    using Input::ModifierKey;
+    using Input::ModifierKeys;
+
+    // =============================================================================================================
+    // 1. Key table (generated from the runtime's real KeyDef.hpp enum; checked by k2/tests/check_table.py against
+    //    KeyDef.cpp spellings, SDL_scancode.h HID usages and Epic's public EKeys list). One row per bindable UE4SS
+    //    key. `fkey` = engine key name (nullptr = the engine has no such key). `hid` / `note` are documentation for
+    //    the device route (option A, not used here) and the table gate.
+    // =============================================================================================================
+    struct KeyRow
+    {
+        Key key;
+        const char* name;
+        const char* fkey;
+        uint16_t hid;
+        const char* note;
+    };
+    struct ModifierRow
+    {
+        ModifierKey modifier;
+        const char* fkey_left;
+        const char* fkey_right;
+        uint16_t hid_left;
+        uint16_t hid_right;
+    };
+    struct HidAlias
+    {
+        uint16_t hid;
+        Key key;
+        const char* note;
+    };
+
+    inline constexpr KeyRow k_key_rows[] = {
+        {Key::LEFT_MOUSE_BUTTON, "LEFT_MOUSE_BUTTON", "LeftMouseButton", 0x00, "mouse button: engine route only (no HID keyboard usage)"},
+        {Key::RIGHT_MOUSE_BUTTON, "RIGHT_MOUSE_BUTTON", "RightMouseButton", 0x00, "mouse button: engine route only (no HID keyboard usage)"},
+        {Key::CANCEL, "CANCEL", nullptr, 0x00, "PC Ctrl+Break; no engine key, no HID usage"},
+        {Key::MIDDLE_MOUSE_BUTTON, "MIDDLE_MOUSE_BUTTON", "MiddleMouseButton", 0x00, "mouse button: engine route only (no HID keyboard usage)"},
+        {Key::XBUTTON_ONE, "XBUTTON_ONE", "ThumbMouseButton", 0x00, "mouse button: engine route only (no HID keyboard usage)"},
+        {Key::XBUTTON_TWO, "XBUTTON_TWO", "ThumbMouseButton2", 0x00, "mouse button: engine route only (no HID keyboard usage)"},
+        {Key::BACKSPACE, "BACKSPACE", "BackSpace", 0x2A, nullptr},
+        {Key::TAB, "TAB", "Tab", 0x2B, nullptr},
+        {Key::CLEAR, "CLEAR", nullptr, 0x9C, "no engine key"},
+        {Key::RETURN, "RETURN", "Enter", 0x28, "keypad Enter (HID 0x58) is an alias"},
+        {Key::PAUSE, "PAUSE", "Pause", 0x48, nullptr},
+        {Key::CAPS_LOCK, "CAPS_LOCK", "CapsLock", 0x39, nullptr},
+        {Key::IME_KANA, "IME_KANA", nullptr, 0x88, "same value as IME_HANGUEL/IME_HANGUL; HID International2 (JP kana), alias HID 0x90 LANG1 (KR hangul); no engine key; enum aliases: IME_HANGUEL, IME_HANGUL"},
+        {Key::IME_ON, "IME_ON", nullptr, 0x00, "PC IME control; no engine key, no HID usage"},
+        {Key::IME_JUNJA, "IME_JUNJA", nullptr, 0x00, "PC IME control; no engine key, no HID usage"},
+        {Key::IME_FINAL, "IME_FINAL", nullptr, 0x00, "PC IME control; no engine key, no HID usage"},
+        {Key::IME_HANJA, "IME_HANJA", nullptr, 0x91, "same value as IME_KANJI; HID LANG2 (KR hanja); no engine key; enum aliases: IME_KANJI"},
+        {Key::IME_OFF, "IME_OFF", nullptr, 0x00, "PC IME control; no engine key, no HID usage"},
+        {Key::ESCAPE, "ESCAPE", "Escape", 0x29, "PS5 system may keep this key; to be checked on console"},
+        {Key::IME_CONVERT, "IME_CONVERT", nullptr, 0x8A, "HID International4 (JP henkan); no engine key"},
+        {Key::IME_NONCONVERT, "IME_NONCONVERT", nullptr, 0x8B, "HID International5 (JP muhenkan); no engine key"},
+        {Key::IME_ACCEPT, "IME_ACCEPT", nullptr, 0x00, "PC IME control; no engine key, no HID usage"},
+        {Key::IME_MODECHANGE, "IME_MODECHANGE", nullptr, 0x00, "PC IME control; no engine key, no HID usage"},
+        {Key::SPACE, "SPACE", "SpaceBar", 0x2C, nullptr},
+        {Key::PAGE_UP, "PAGE_UP", "PageUp", 0x4B, nullptr},
+        {Key::PAGE_DOWN, "PAGE_DOWN", "PageDown", 0x4E, nullptr},
+        {Key::END, "END", "End", 0x4D, nullptr},
+        {Key::HOME, "HOME", "Home", 0x4A, nullptr},
+        {Key::LEFT_ARROW, "LEFT_ARROW", "Left", 0x50, nullptr},
+        {Key::UP_ARROW, "UP_ARROW", "Up", 0x52, nullptr},
+        {Key::RIGHT_ARROW, "RIGHT_ARROW", "Right", 0x4F, nullptr},
+        {Key::DOWN_ARROW, "DOWN_ARROW", "Down", 0x51, nullptr},
+        {Key::SELECT, "SELECT", nullptr, 0x77, "no engine key"},
+        {Key::PRINT, "PRINT", nullptr, 0x00, "PC-only virtual key; no HID usage"},
+        {Key::EXECUTE, "EXECUTE", nullptr, 0x74, "no engine key"},
+        {Key::PRINT_SCREEN, "PRINT_SCREEN", nullptr, 0x46, "no engine key; PS5 system may keep it"},
