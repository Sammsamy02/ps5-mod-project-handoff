+    // Dense name ids for the reader's O(1) name cache: 0..255 = the UE4SS key value (its engine name is fkey_for),
+    // 256 + 2*row + side = the modifier names (side 0 = left, 1 = right).
+    inline constexpr uint16_t k_modifier_id_base = 256;
+    inline constexpr uint16_t k_name_id_count = static_cast<uint16_t>(k_modifier_id_base + 2 * std::size(k_modifier_rows));
+
+    // =============================================================================================================
+    // 2. Engine boundary (game thread only)
+    // =============================================================================================================
+    class KeyStateReader
+    {
+      public:
+        enum class Frame : uint8_t
+        {
+            Ready,        // controller found, function usable
+            NoController, // loading screen / no local player yet: try later
+            Unsupported,  // this engine build cannot answer: stop for good (fail closed)
+        };
+        struct FrameInfo
+        {
+            Frame status;
+            uint64_t controller_generation; // changes when the controller object changes
+        };
+        virtual ~KeyStateReader() = default;
+        virtual auto begin_frame() -> FrameInfo = 0;
+        // nullopt = this one read failed (key name not in this game, refused call); never throws on purpose
+        virtual auto is_down(uint16_t name_id, const char* fkey_name) -> std::optional<bool> = 0;
+        // short reason for the one-time "[kbm] engine-keys supported=0 reason=<...>" line
+        virtual auto unsupported_reason() const -> const char* { return "unsupported"; }
+    };
+
+    // =============================================================================================================
+    // 3. Reflection-checked reader. KeyReflection is the narrow reflection model it needs; the runtime implements
+    //    it with the port's reflection (UObject / UFunction / FProperty / FName), the host tests with a fake model.
+    //    Every number the reader uses (parameter offsets, sizes, bool byte/mask, ParmsSize, FName size) comes from
+    //    this model at run time; nothing is hand-written.
+    // =============================================================================================================
+    class KeyReflection
+    {
+      public:
+        using Handle = void*; // opaque UObject* / UClass* / UFunction* / UScriptStruct*
+        enum class Kind : uint8_t
+        {
+            Other,
+            Bool,
+            Struct,
+            Name,
+        };
+        // One reflected property: a function parameter or a struct member.
+        struct Field
+        {
+            Kind kind{Kind::Other};
+            bool parm{}, ret{}, out{}, ref{}; // CPF_Parm / CPF_ReturnParm / CPF_OutParm / CPF_ReferenceParm
+            int32_t offset{-1};               // reflected Offset_Internal
+            int32_t size{};                   // reflected size (ElementSize * ArrayDim)
+            int32_t array_dim{1};
+            Handle struct_type{};             // Kind::Struct: the UScriptStruct
+            bool name_is_keyname{};           // engine name == "KeyName" (ASCII case-insensitive, as the engine compares)
+            uint8_t bool_byte_offset{};       // Kind::Bool: reflected ByteOffset
+            uint8_t bool_field_mask{};        // Kind::Bool: reflected FieldMask
+        };
+        virtual ~KeyReflection() = default;
+        // The local player's controller (its Player is a LocalPlayer), nullptr = none yet. Must not throw.
+        virtual auto find_local_controller() -> Handle = 0;
+        // The object's own object-array index. Only called on an object just returned live by find_local_controller.
+        virtual auto object_index(Handle object) -> int32_t = 0;
+        // O(1) liveness WITHOUT reading the object: slot `index` still holds this pointer and it is reachable. Safe on
+        // a cached pointer whose object the engine may have freed since (level change, GC).
+        virtual auto is_live_at(Handle object, int32_t index) -> bool = 0;
+        virtual auto class_of(Handle object) -> Handle = 0;
+        virtual auto find_function(Handle object, const char* name) -> Handle = 0; // by name, through the class chain
+        // ParmsSize, ReturnValueOffset (-1 = none) and every CPF_Parm property; false = unreadable
+        virtual auto function_layout(Handle function, int32_t& parms_size, int32_t& return_offset, std::vector<Field>& params) -> bool = 0;
+        virtual auto struct_is_named(Handle script_struct, const char* name) -> bool = 0;
+        virtual auto struct_members(Handle script_struct, std::vector<Field>& members) -> bool = 0;
+        virtual auto name_size() -> size_t = 0; // sizeof the runtime's FName
+        // Find-only FName lookup (FNAME_Find: never adds to the game's name table). false = not in this game.
+        virtual auto find_name(const char* ascii, uint8_t* out, size_t cap) -> bool = 0;
+        // Second source for the name route: the found FName equals the UFunction's own reflected name.
+        virtual auto name_matches_function(Handle function, const uint8_t* name_bytes) -> bool = 0;
+        virtual void call(Handle object, Handle function, void* frame) = 0; // the UFunction call path Lua uses
+        virtual auto now_ms() -> uint64_t = 0;
+    };
+
+    class EngineKeyReader final : public KeyStateReader
+    {
+      public:
+        using Handle = KeyReflection::Handle;
+        // Controller search while none is cached: first try at once, then 0.5 s, 1 s, 2 s, ... up to 8 s between
+        // tries (reset after a find). A search that itself took >= 4 ms jumps straight to 8 s (a slow full object walk
+        // must never repeat often).
+        static constexpr uint64_t k_probe_interval_ms = 500;
+        static constexpr uint64_t k_probe_max_ms = 8000;
+        static constexpr uint64_t k_slow_probe_ms = 4;
+        static constexpr int32_t k_max_parms_size = 4096;     // sanity bound on the reflected ParmsSize
+        static constexpr size_t k_max_name_size = 16;
+
+        explicit EngineKeyReader(std::unique_ptr<KeyReflection> model) : m_model(std::move(model))
+        {
+            if (!m_model) m_reason = "no-reflection";
+        }
+
+        auto begin_frame() -> FrameInfo override
+        {
+            if (m_reason) return {Frame::Unsupported, m_generation};
+            // Cache rebuilt on miss: the cached controller must still own its object-array slot (checked without
+            // touching the object) and still have the same class.
+            if (m_pc && (!m_model->is_live_at(m_pc, m_pc_index) || m_model->class_of(m_pc) != m_pc_class)) m_pc = nullptr;
+            if (!m_pc)
+            {
+                const uint64_t now = m_model->now_ms();
+                if (m_probed && now < m_next_probe_ms) return {Frame::NoController, m_generation};
+                m_probed = true;
+                Handle pc = m_model->find_local_controller();
+                const uint64_t after = m_model->now_ms();
+                const int32_t index = pc ? m_model->object_index(pc) : -1;
+                Handle cls = pc && m_model->is_live_at(pc, index) ? m_model->class_of(pc) : nullptr;
+                if (!cls)
+                {
+                    // miss: back off (exponential, capped; a slow search goes straight to the cap)
+                    if (after - now >= k_slow_probe_ms) m_probe_wait_ms = k_probe_max_ms;
+                    m_next_probe_ms = after + m_probe_wait_ms;
+                    m_probe_wait_ms = std::min(m_probe_wait_ms * 2, k_probe_max_ms);
+                    ++m_probe_misses;
+                    return {Frame::NoController, m_generation};
+                }
+                m_probe_wait_ms = k_probe_interval_ms;
+                m_next_probe_ms = 0; // a later loss searches again at once
+                if (cls != m_fn_class)
+                {
+                    if (const char* why = resolve(pc))
+                    {
+                        m_reason = why;
+                        return {Frame::Unsupported, m_generation};
+                    }
+                    m_fn_class = cls;
+                }
+                m_pc = pc;
+                m_pc_index = index;
+                m_pc_class = cls;
+                ++m_generation;
+            }
+            return {Frame::Ready, m_generation};
+        }
+
+        auto is_down(uint16_t name_id, const char* fkey_name) -> std::optional<bool> override
+        {
+            if (m_reason || !m_fn || !m_pc || !fkey_name || name_id >= k_name_id_count) return std::nullopt;
+            CachedName& name = m_names[name_id];
+            if (name.state == NameState::Unresolved)
+            {
+                // Looked up once (find-only); a miss is cached as "key not in this game".
+                name.state = m_model->find_name(fkey_name, name.bytes.data(), name.bytes.size()) ? NameState::Found : NameState::Missing;
+                ++m_name_lookups;
+            }
+            if (name.state != NameState::Found) return std::nullopt;
+            auto* frame = reinterpret_cast<uint8_t*>(m_frame.data());
+            const size_t frame_bytes = m_frame.size() * sizeof(std::max_align_t);
+            std::memset(frame, 0, frame_bytes);
+            std::memcpy(frame + m_name_offset, name.bytes.data(), m_name_size);
+            m_model->call(m_pc, m_fn, frame);
+            // The Key parameter is passed by value: the engine copies it and never writes it back. Anything but our
+            // KeyName in it now means the layout is not what we checked -> stop for good (no destructor guesswork).
+            for (int32_t i = m_key_offset; i < m_key_offset + m_key_size; ++i)
+            {
+                const bool in_name = i >= m_name_offset && i < m_name_offset + static_cast<int32_t>(m_name_size);
+                const uint8_t expected = in_name ? name.bytes[static_cast<size_t>(i - m_name_offset)] : 0;
+                if (frame[i] != expected)
+                {
+                    m_reason = "key-param-written";
+                    return std::nullopt;
+                }
+            }
+            return (frame[m_ret_offset + m_ret_byte] & m_ret_mask) != 0;
+        }
+
+        auto unsupported_reason() const -> const char* override { return m_reason ? m_reason : "unsupported"; }
+
+        // test / diagnostic views
+        auto generation() const -> uint64_t { return m_generation; }
+        auto name_lookups() const -> uint64_t { return m_name_lookups; }
+        auto probe_misses() const -> uint64_t { return m_probe_misses; }
+
+      private:
+        using Field = KeyReflection::Field;
+        using Kind = KeyReflection::Kind;
+
+        // nullptr = the layout is the one we can use (and is now committed); otherwise the refusal reason.
+        auto resolve(Handle pc) -> const char*
+        {
+            Handle fn = m_model->find_function(pc, "IsInputKeyDown");
+            if (!fn) return "no-function";
+            int32_t parms_size = -1, return_offset = -1;
+            m_params.clear();
+            if (!m_model->function_layout(fn, parms_size, return_offset, m_params)) return "layout:unreadable";
+            if (parms_size <= 0 || parms_size > k_max_parms_size) return "layout:parms-size";
+            const Field* key = nullptr;
+            const Field* ret = nullptr;
+            int parms = 0;
+            for (const auto& f : m_params)
+            {
+                if (!f.parm) continue;
+                ++parms;
+                if (f.ret)
+                {
+                    if (ret) return "layout:return";
+                    ret = &f;
+                }
+                else
+                {
+                    if (key) return "layout:param-count";
+                    key = &f;
+                }
+            }
+            if (parms != 2 || !key || !ret) return "layout:param-count";
+            // one bool return value, at the function's own return-value offset, inside ParmsSize
+            if (ret->kind != Kind::Bool || ret->array_dim != 1 || ret->offset < 0 || ret->offset != return_offset || ret->size < 1 ||
+                ret->offset + ret->size > parms_size || ret->bool_field_mask == 0 || ret->bool_byte_offset >= ret->size)
+                return "layout:return";
+            // one `Key` struct parameter, by value (not out / ref), inside ParmsSize, not overlapping the return value
+            if (key->kind != Kind::Struct || !key->struct_type || key->out || key->ref || key->array_dim != 1 || key->offset < 0 ||
+                key->size <= 0 || key->offset + key->size > parms_size)
+                return "layout:key-param";
+            if (key->offset < ret->offset + ret->size && ret->offset < key->offset + key->size) return "layout:overlap";
+            if (!m_model->struct_is_named(key->struct_type, "Key")) return "layout:key-struct";
+            // ... holding exactly one FName KeyName (the engine's own member offset; size = the runtime's FName)
+            m_members.clear();
+            if (!m_model->struct_members(key->struct_type, m_members)) return "layout:key-members";
+            const Field* key_name = nullptr;
+            for (const auto& m : m_members)
+            {
+                if (!m.name_is_keyname) continue;
+                if (key_name) return "layout:keyname";
+                key_name = &m;
+            }
+            const size_t name_size = m_model->name_size();
+            if (!key_name || key_name->kind != Kind::Name || key_name->array_dim != 1 || key_name->offset < 0 || name_size == 0 ||
+                name_size > k_max_name_size || static_cast<size_t>(key_name->size) != name_size || key_name->offset + key_name->size > key->size)
+                return "layout:keyname";
+            // Two sources for the name route: the find-only lookup of the function's name must give the UFunction's
+            // own reflected name.
+            std::array<uint8_t, k_max_name_size> probe{};
+            if (!m_model->find_name("IsInputKeyDown", probe.data(), probe.size()) || !m_model->name_matches_function(fn, probe.data()))
+                return "fname-find";
+            // commit
+            m_fn = fn;
+            m_key_offset = key->offset;
+            m_key_size = key->size;
+            m_name_offset = key->offset + key_name->offset;
+            m_name_size = name_size;
+            m_ret_offset = ret->offset;
+            m_ret_byte = ret->bool_byte_offset;
+            m_ret_mask = ret->bool_field_mask;
+            m_frame.assign(static_cast<size_t>(parms_size) / sizeof(std::max_align_t) + 2, std::max_align_t{});
+            return nullptr;
+        }
+
+        enum class NameState : uint8_t
+        {
+            Unresolved,
+            Found,
+            Missing,
+        };
+        struct CachedName
+        {
+            NameState state{NameState::Unresolved};
+            std::array<uint8_t, k_max_name_size> bytes{};
+        };
+
+        std::unique_ptr<KeyReflection> m_model;
+        const char* m_reason{}; // set = Unsupported for good
+        Handle m_pc{}, m_pc_class{}, m_fn{}, m_fn_class{};
+        uint64_t m_generation{};
+        uint64_t m_next_probe_ms{};
+        uint64_t m_probe_wait_ms{k_probe_interval_ms};
+        uint64_t m_probe_misses{};
+        int32_t m_pc_index{-1};
+        bool m_probed{};
+        int32_t m_key_offset{}, m_key_size{}, m_name_offset{}, m_ret_offset{};
+        size_t m_name_size{};
+        uint8_t m_ret_byte{}, m_ret_mask{};
+        uint64_t m_name_lookups{};
+        std::vector<std::max_align_t> m_frame; // zeroed parameter frame, sized from the reflected ParmsSize
+        std::vector<Field> m_params, m_members;
+        std::array<CachedName, k_name_id_count> m_names{};
+    };
+
+    // =============================================================================================================
+    // 4. Channel (lock-free; single producer = game-thread sampler, single consumer = update-thread source)
+    // =============================================================================================================
+    struct EngineKeyChannel
+    {
+        static constexpr int ring_slots = 256; // RingBufferSPSC holds slots-1 events
+        Input::RingBufferSPSC<InputEvent, ring_slots> ring;
+        std::array<std::atomic<uint64_t>, 4> subscribed{}; // bit k = UE4SS key k has a bind
+        std::atomic<uint32_t> bound{0};                     // subscribed keys that have an engine key name
+        std::atomic<bool> published{false};                 // the update thread published the subscriptions once
+        std::atomic<bool> open{true};                       // false after deactivate / retirement
+        std::atomic<int> support{0};                        // 0 unknown, 1 yes, -1 no (permanent)
+        std::atomic<uint32_t> divisor{1};                   // sample every Nth due pump call
+        // Diagnostics (monotonic counters).
+        std::atomic<uint64_t> frames{}, sampled_frames{}, reads{}, read_failures{};
+        std::atomic<uint64_t> events{}, drops{}, throttle_steps{};
+    };
+
+    struct SamplerConfig
+    {
+        uint64_t budget_ns = 250'000;                   // sampling cost allowed per sampled frame
+        uint32_t over_budget_frames = 3;                // consecutive overruns before slowing down
+        uint32_t max_divisor = 8;                       // never slower than every 8th due frame
+        uint32_t max_keys_per_frame = 64;               // above this, keys are sampled round-robin
+        uint64_t min_interval_ns = 8'000'000;           // the pump can run several times per engine frame
+        uint32_t recover_frames = 60;                   // this many sampled frames in a row under budget halve the divisor
+        uint64_t summary_interval_ns = 60'000'000'000;  // one "[kbm] SUM" line per minute
+    };
+
+    // =============================================================================================================
+    // 5. Sampler (game thread; the ONLY caller of the reader)
+    // =============================================================================================================
+    class EngineKeySampler
+    {
+      public:
+        using Clock = std::function<uint64_t()>;
+        using LogSink = std::function<void(const char*)>;
+
+        EngineKeySampler(std::shared_ptr<EngineKeyChannel> channel, std::unique_ptr<KeyStateReader> reader, SamplerConfig config = {},
+                         Clock now_ns = {}, LogSink log = {})
+            : m_channel(std::move(channel)), m_reader(std::move(reader)), m_config(config), m_now(std::move(now_ns)), m_log(std::move(log))
+        {
+            if (!m_now) m_now = &detail::steady_now_ns;
+            if (m_config.max_divisor == 0) m_config.max_divisor = 1;
+            if (m_config.max_keys_per_frame == 0) m_config.max_keys_per_frame = 1;
+            if (m_config.max_keys_per_frame > Input::max_keys) m_config.max_keys_per_frame = Input::max_keys;
+            m_work.reserve(Input::max_keys);
+            m_edges.reserve(Input::max_keys);
+            // No reader = this route can never answer: fail closed.
+            if (!m_reader && m_channel)
+            {
+                m_channel->support.store(-1, std::memory_order_release);
+                m_fail_reason = "no-reader";
+            }
+        }
+
+        // Once per game-thread pump call. Never throws: any exception switches the engine-keys source off.
+        void tick() noexcept
+        {
+            if (!m_channel) return;
+            try
+            {
+                tick_body();
+            }
+            catch (...)
+            {
+                m_channel->support.store(-1, std::memory_order_release);
+                if (!m_fail_reason) m_fail_reason = "exception";
+                try
+                {
+                    announce(false);
+                }
+                catch (...)
+                {
+                }
+            }
+        }
+
+        auto announced() const -> bool { return m_announced; }
+
+      private:
+        enum class State : uint8_t
+        {
+            Unknown, // no baseline yet: the next read never produces an event
+            Up,
+            Down,
+        };
+
+        void tick_body()
+        {
+            auto& ch = *m_channel;
+            ch.frames.fetch_add(1, std::memory_order_relaxed);
+            const uint64_t now = m_now();
+            summary(now);
+            if (ch.support.load(std::memory_order_acquire) < 0)
+            {
+                announce(false);
+                return;
+            }
+            if (!ch.open.load(std::memory_order_acquire)) return;
+            if (m_sampled_once && now - m_last_sample_ns < m_config.min_interval_ns) return;
+            if (++m_phase < ch.divisor.load(std::memory_order_relaxed)) return;
+            m_phase = 0;
+            m_sampled_once = true;
+            m_last_sample_ns = now;
+
+            // Only keys a mod actually registered, and only keys the engine has a name for. No such key = no engine
+            // call at all this frame (not even the controller search).
+            m_work.clear();
+            for (unsigned word = 0; word < ch.subscribed.size(); ++word)
+            {
+                const uint64_t bits = ch.subscribed[word].load(std::memory_order_acquire);
+                for (unsigned bit = 0; bit < 64; ++bit)
+                {
+                    const unsigned value = word * 64 + bit;
+                    if (value == 0 || value >= Input::max_keys) continue;
+                    const Key key = static_cast<Key>(value);
+                    if (!((bits >> bit) & 1u) || !fkey_for(key))
+                    {
+                        m_state[value] = State::Unknown;
+                        continue;
+                    }
+                    m_work.push_back(key);
+                }
+            }
+            if (m_work.empty()) return;
+
+            const auto info = m_reader->begin_frame();
+            if (info.status == KeyStateReader::Frame::Unsupported)
+            {
+                ch.support.store(-1, std::memory_order_release);
+                m_fail_reason = m_reader->unsupported_reason();
+                reset_baseline();
+                announce(false);
+                return;
+            }
+            if (info.status == KeyStateReader::Frame::NoController)
+            {
+                reset_baseline();
+                m_generation = ~0ull;
+                account(m_now() - now); // a controller search counts against the budget too
+                return;
+            }
+            if (info.controller_generation != m_generation)
+            {
+                // A new controller (level change, loading screen): keys already held never fire.
+                reset_baseline();
+                m_generation = info.controller_generation;
+            }
+            int unknown = 0;
+            ch.support.compare_exchange_strong(unknown, 1, std::memory_order_acq_rel);
+            ch.sampled_frames.fetch_add(1, std::memory_order_relaxed);
+            if (!m_announced) announce(true); // m_work is not empty, so the subscriptions were published
+
+            size_t count = m_work.size();
+            size_t start = 0;
+            if (count > m_config.max_keys_per_frame)
+            {
+                start = m_round_robin % count;
+                m_round_robin = static_cast<uint32_t>((start + m_config.max_keys_per_frame) % count);
+                count = m_config.max_keys_per_frame;
+            }
+
+            m_edges.clear();
+            for (size_t i = 0; i < count; ++i)
+            {
+                const Key key = m_work[(start + i) % m_work.size()];
+                const auto down = m_reader->is_down(static_cast<uint16_t>(key), fkey_for(key));
+                ch.reads.fetch_add(1, std::memory_order_relaxed);
+                if (!down)
+                {
+                    ch.read_failures.fetch_add(1, std::memory_order_relaxed);
+                    continue; // keep the previous state; no event from a failed read
+                }
+                State& state = m_state[static_cast<uint8_t>(key)];
+                // Key-down edge only (UE4SS RegisterKeyBind fires on press, no auto-repeat).
+                if (state == State::Up && *down) m_edges.push_back(key);
+                state = *down ? State::Down : State::Up;
+            }
+            if (!m_edges.empty())
+            {
+                // Modifiers only on a frame with an edge (same engine frame, so the same answer as reading first).
+                const ModifierKeys mods = read_modifiers();
+                for (const Key key : m_edges)
+                {
+                    if (ch.ring.push(InputEvent{key, mods}))
+                        ch.events.fetch_add(1, std::memory_order_relaxed);
+                    else
+                        ch.drops.fetch_add(1, std::memory_order_relaxed);
+                }
+            }
+            account(m_now() - now);
+        }
+
+        void reset_baseline() { m_state.fill(State::Unknown); }
+
+        auto read_modifiers() -> ModifierKeys
+        {
+            auto& ch = *m_channel;
+            ModifierKeys mods{};
+            uint16_t id = k_modifier_id_base;
+            for (const auto& row : k_modifier_rows)
+            {
+                const auto left = m_reader->is_down(id++, row.fkey_left);
+                const auto right = m_reader->is_down(id++, row.fkey_right);
+                ch.reads.fetch_add(2, std::memory_order_relaxed);
+                if (!left) ch.read_failures.fetch_add(1, std::memory_order_relaxed);
+                if (!right) ch.read_failures.fetch_add(1, std::memory_order_relaxed);
+                // A failed modifier read counts as "not held" (never invents a modifier).
+                if (left.value_or(false) || right.value_or(false)) mods |= row.modifier;
+            }
+            return mods;
+        }
+
+        void account(uint64_t cost_ns)
+        {
+            auto& ch = *m_channel;
+            if (cost_ns <= m_config.budget_ns)
+            {
+                m_over = 0;
+                // recover: a long run under budget halves the divisor again (one slow patch never slows it for good)
+                const uint32_t current = ch.divisor.load(std::memory_order_relaxed);
+                if (current > 1 && ++m_under >= m_config.recover_frames)
+                {
+                    m_under = 0;
+                    ch.divisor.store(current / 2, std::memory_order_relaxed);
+                }
+                return;
+            }
+            m_under = 0;
+            if (++m_over < m_config.over_budget_frames) return;
+            m_over = 0;
+            const uint32_t current = ch.divisor.load(std::memory_order_relaxed);
+            if (current >= m_config.max_divisor) return;
+            ch.divisor.store(std::min(current * 2, m_config.max_divisor), std::memory_order_relaxed);
+            ch.throttle_steps.fetch_add(1, std::memory_order_relaxed);
+        }
+
+        void emit(const char* line)
+        {
+            if (!m_log) return;
+            try
+            {
+                m_log(line);
+            }
+            catch (...)
+            {
+            }
+        }
+
+        // Exactly once per process: "[kbm] engine-keys supported=<0|1> reason=<...> bound=<n>". If a source that
+        // already said supported=1 later switches itself off (exception, engine wrote the Key parameter), one more
+        // line, also at most once: "[kbm] engine-keys stopped reason=<...>".
+        void announce(bool supported)
+        {
+            if (m_announced)
+            {
+                if (supported || !m_announced_supported || m_stop_announced) return;
+                m_stop_announced = true;
+                char stopped[96];
+                std::snprintf(stopped, sizeof stopped, "[kbm] engine-keys stopped reason=%s", m_fail_reason ? m_fail_reason : "unsupported");
+                emit(stopped);
+                return;
+            }
+            m_announced = true;
+            m_announced_supported = supported;
+            char line[160];
+            std::snprintf(line, sizeof line, "[kbm] engine-keys supported=%d reason=%s bound=%u", supported ? 1 : 0,
+                          supported ? "ok" : (m_fail_reason ? m_fail_reason : "unsupported"),
+                          static_cast<unsigned>(m_channel->bound.load(std::memory_order_acquire)));
+            emit(line);
+        }
+
+        // Every summary_interval_ns: "[kbm] SUM frames= sampled= reads= fails= events= drops= divisor=". At the first
+        // one, if nothing was decided yet, also once: "[kbm] engine-keys waiting reason=<no-binds|no-controller> bound=<n>".
+        void summary(uint64_t now)
+        {
+            if (!m_summary_started)
+            {
+                m_summary_started = true;
+                m_next_summary_ns = now + m_config.summary_interval_ns;
+                return;
+            }
+            if (now < m_next_summary_ns) return;
+            m_next_summary_ns = now + m_config.summary_interval_ns;
+            const auto& ch = *m_channel;
+            char line[224];
+            std::snprintf(line, sizeof line, "[kbm] SUM frames=%llu sampled=%llu reads=%llu fails=%llu events=%llu drops=%llu divisor=%u",
+                          static_cast<unsigned long long>(ch.frames.load(std::memory_order_relaxed)),
+                          static_cast<unsigned long long>(ch.sampled_frames.load(std::memory_order_relaxed)),
+                          static_cast<unsigned long long>(ch.reads.load(std::memory_order_relaxed)),
+                          static_cast<unsigned long long>(ch.read_failures.load(std::memory_order_relaxed)),
+                          static_cast<unsigned long long>(ch.events.load(std::memory_order_relaxed)),
+                          static_cast<unsigned long long>(ch.drops.load(std::memory_order_relaxed)),
+                          static_cast<unsigned>(ch.divisor.load(std::memory_order_relaxed)));
+            emit(line);
+            if (!m_announced && !m_waiting_announced)
+            {
+                m_waiting_announced = true;
+                const unsigned bound = ch.bound.load(std::memory_order_acquire);
+                char waiting[96];
+                std::snprintf(waiting, sizeof waiting, "[kbm] engine-keys waiting reason=%s bound=%u", bound ? "no-controller" : "no-binds", bound);
+                emit(waiting);
+            }
+        }
+
+        std::shared_ptr<EngineKeyChannel> m_channel;
+        std::unique_ptr<KeyStateReader> m_reader;
+        SamplerConfig m_config;
+        Clock m_now;
+        LogSink m_log;
+        std::array<State, 256> m_state{};
+        std::vector<Key> m_work;
+        std::vector<Key> m_edges;
+        uint64_t m_generation{~0ull};
+        uint64_t m_last_sample_ns{};
+        uint64_t m_next_summary_ns{};
+        const char* m_fail_reason{};
+        uint32_t m_phase{};
+        uint32_t m_round_robin{};
+        uint32_t m_over{};
+        uint32_t m_under{};
+        bool m_sampled_once{};
+        bool m_summary_started{};
+        bool m_announced{};
+        bool m_announced_supported{};
+        bool m_stop_announced{};
+        bool m_waiting_announced{};
+    };
+
+    // =============================================================================================================
+    // 6. Source (UE4SS update thread; a normal PlatformInputSource)
+    // =============================================================================================================
+    class EngineKeySource final : public Input::PlatformInputSource
+    {
+      public:
+        explicit EngineKeySource(std::shared_ptr<EngineKeyChannel> channel) : m_channel(std::move(channel))
+        {
+            m_events.reserve(EngineKeyChannel::ring_slots);
+        }
+        // true once the engine answered at least once
+        bool is_available() override
+        {
+            return m_channel && m_channel->open.load(std::memory_order_acquire) && m_channel->support.load(std::memory_order_acquire) == 1;
+        }
+        // nothing to open: (re)opens the channel
+        bool activate() override
+        {
+            if (!m_channel) return false;
+            m_channel->open.store(true, std::memory_order_release);
+            return is_available();
+        }
+        // closes the channel; the sampler stops calling the engine
+        bool deactivate() override
+        {
+            m_events.clear();
+            if (m_channel) m_channel->open.store(false, std::memory_order_release);
+            return true;
+        }
+        int source_priority() override { return 90; }
+        const char* get_name() override { return "EngineKeys"; }
+
+        std::vector<InputEvent>& process_event(Input::Handler* handler) override
+        {
+            m_events.clear();
+            if (!handler || !m_channel) return m_events;
+            auto& ch = *m_channel;
+            // Publish which keys have binds, so the game-thread sampler asks the engine about those keys only.
+            const auto& subscribed = handler->get_subscribed_keys();
+            std::array<uint64_t, 4> words{};
+            uint32_t bound = 0;
+            for (size_t value = 0; value < subscribed.size(); ++value)
+            {
+                if (!subscribed[value]) continue;
+                words[value / 64] |= 1ull << (value % 64);
+                if (fkey_for(static_cast<Key>(value))) ++bound;
+            }
+            for (size_t word = 0; word < words.size(); ++word) ch.subscribed[word].store(words[word], std::memory_order_release);
+            ch.bound.store(bound, std::memory_order_release);
+            ch.published.store(true, std::memory_order_release);
+            // Always drain (stale presses never pile up); deliver only when allowed. No allocation: reserved above.
+            const bool deliver = ch.open.load(std::memory_order_acquire) && handler->get_allow_input();
+            while (auto event = ch.ring.pop())
+            {
+                const auto value = static_cast<size_t>(event->key);
+                if (!deliver || value >= subscribed.size() || !subscribed[value]) continue;
+                if (m_events.size() < m_events.capacity()) m_events.push_back(*event);
+            }
+            return m_events;
+        }
+
+      private:
+        std::shared_ptr<EngineKeyChannel> m_channel;
+        std::vector<InputEvent> m_events;
+    };
+
+    // =============================================================================================================
+    // 7. Merged source: the handler takes ONE source. Every child is polled on every call (the pad keeps its own
+    //    borrowed-handle retry); the same key+modifiers from two different children in one poll is one press (pad
+    //    L3+R3 = F7 together with keyboard F7); a throwing child is skipped and counted; activation never fails just
+    //    because one child is down.
+    // =============================================================================================================
+    class CompositeInputSource final : public Input::PlatformInputSource
+    {
+      public:
+        explicit CompositeInputSource(std::vector<std::shared_ptr<Input::PlatformInputSource>> children)
+        {
+            for (auto& child : children)
+                if (child) m_children.push_back(std::move(child));
+            m_events.reserve(256);
+        }
+        bool is_available() override
+        {
+            for (auto& child : m_children)
+            {
+                try
+                {
+                    if (child->is_available()) return true;
+                }
+                catch (...)
+                {
+                    ++m_child_exceptions;
+                }
+            }
+            return false;
+        }
+        bool activate() override
+        {
+            bool any = false;
+            for (auto& child : m_children)
+            {
+                try
+                {
+                    // Only children that are available now; the others stay attached and retry from their poll path.
+                    if (child->is_available() && child->activate()) any = true;
+                }
+                catch (...)
+                {
+                    ++m_child_exceptions;
+                }
+            }
+            return any;
+        }
+        bool deactivate() override
+        {
+            bool all = true;
+            m_events.clear();
+            for (auto& child : m_children)
+            {
+                try
+                {
+                    if (!child->deactivate()) all = false; // the child keeps its owner for a retry
+                }
+                catch (...)
+                {
+                    ++m_child_exceptions;
+                    all = false;
+                }
+            }
+            return all;
+        }
+        int source_priority() override
+        {
+            int best = 999;
+            for (auto& child : m_children) best = std::min(best, child->source_priority());
+            return best;
+        }
+        const char* get_name() override { return "Merged"; }
+
+        std::vector<InputEvent>& process_event(Input::Handler* handler) override
+        {
+            m_events.clear();
+            for (auto& child : m_children)
+            {
+                try
+                {
+                    // Merge only ACROSS children: two presses queued by one child are two presses, as on PC.
+                    const auto earlier = static_cast<std::ptrdiff_t>(m_events.size());
+                    for (const auto& event : child->process_event(handler))
+                    {
+                        const bool duplicate = std::any_of(m_events.begin(), m_events.begin() + earlier, [&](const InputEvent& seen) {
+                            return seen.key == event.key && seen.modifier_keys == event.modifier_keys;
+                        });
+                        if (duplicate)
+                        {
+                            ++m_duplicates;
+                            continue;
+                        }
+                        m_events.push_back(event);
+                    }
+                }
+                catch (...)
+                {
+                    ++m_child_exceptions; // isolate: one broken child never silences the others
+                }
+            }
+            return m_events;
+        }
+
+        auto child_exceptions() const -> uint64_t { return m_child_exceptions; }
+        auto duplicates_merged() const -> uint64_t { return m_duplicates; }
+        auto children() const -> size_t { return m_children.size(); }
+
+      private:
+        std::vector<std::shared_ptr<Input::PlatformInputSource>> m_children;
+        std::vector<InputEvent> m_events;
+        uint64_t m_child_exceptions{};
+        uint64_t m_duplicates{};
+    };
+
+    // =============================================================================================================
+    // 8. Composition helper (engine-free half of KbmComposeInput): Merged{ supplied source if any, engine keys }.
+    //    May throw (allocation); the caller commits only after it returned.
+    // =============================================================================================================
+    inline auto make_merged_input(const std::shared_ptr<Input::PlatformInputSource>& supplied, const std::shared_ptr<EngineKeyChannel>& channel)
+            -> std::shared_ptr<CompositeInputSource>
+    {
+        std::vector<std::shared_ptr<Input::PlatformInputSource>> children;
+        if (supplied) children.push_back(supplied);
+        children.push_back(std::make_shared<EngineKeySource>(channel));
+        return std::make_shared<CompositeInputSource>(std::move(children));
+    }
+
+    // =============================================================================================================
+    // 9. Runtime glue, engine-free. KbmEngineKeysRuntime.inc creates ONE instance on the constructor thread and never
+    //    frees it (a game-thread pump call may still be running while the program tears down).
+    //      compose(input)  constructor thread, before Handler::init; once; never throws; false = input unchanged
+    //      frame()         game thread, every pump call (both drains may call it; the 8 ms gate keeps it once per frame)
+    //      retire()        teardown, after Handler::shutdown: handler shutdown -> pump retirement -> unload
+    // =============================================================================================================
+    class EngineKeysRuntime
+    {
+      public:
+        using ReaderFactory = std::function<std::unique_ptr<KeyStateReader>()>;
+
+        EngineKeysRuntime(ReaderFactory factory, SamplerConfig config = {}, EngineKeySampler::Clock clock = {}, EngineKeySampler::LogSink log = {})
+            : m_factory(std::move(factory)), m_config(config), m_clock(std::move(clock)), m_log(std::move(log))
+        {
+        }
+
+        auto compose(std::shared_ptr<Input::PlatformInputSource>& input) noexcept -> bool
+        {
+            try
+            {
+                if (m_live.load(std::memory_order_acquire)) return false; // once per process
+                auto channel = std::make_shared<EngineKeyChannel>();
+                auto sampler = std::make_unique<EngineKeySampler>(channel, m_factory ? m_factory() : nullptr, m_config, m_clock, m_log);
+                auto merged = make_merged_input(input, channel);
+                // commit (nothing below can throw)
+                m_channel = std::move(channel);
+                m_sampler = std::move(sampler);
+                m_live.store(m_sampler.get(), std::memory_order_release);
+                input = std::move(merged);
+                return true;
+            }
+            catch (...)
+            {
+                return false; // the supplied source stays exactly as it was (pad only, as before K2)
+            }
+        }
+
+        void frame() noexcept
+        {
+            EngineKeySampler* sampler = m_live.load(std::memory_order_acquire);
+            if (!sampler || m_in_frame || m_retired.load(std::memory_order_acquire)) return;
+            m_in_frame = true; // game thread only: a nested pump call (engine re-entry) samples nothing
+            sampler->tick();   // noexcept; fails closed internally
+            m_in_frame = false;
+        }
+
+        void retire() noexcept
+        {
+            m_retired.store(true, std::memory_order_release);
+            if (m_live.load(std::memory_order_acquire) && m_channel) m_channel->open.store(false, std::memory_order_release);
+        }
+
+        auto composed() const -> bool { return m_live.load(std::memory_order_acquire) != nullptr; }
+        auto retired() const -> bool { return m_retired.load(std::memory_order_acquire); }
+        auto channel() const -> const std::shared_ptr<EngineKeyChannel>& { return m_channel; }
+
+      private:
+        ReaderFactory m_factory;
+        SamplerConfig m_config;
+        EngineKeySampler::Clock m_clock;
+        EngineKeySampler::LogSink m_log;
+        std::shared_ptr<EngineKeyChannel> m_channel;
+        std::unique_ptr<EngineKeySampler> m_sampler;
+        std::atomic<EngineKeySampler*> m_live{nullptr};
+        std::atomic<bool> m_retired{false};
+        bool m_in_frame{false};
+    };
+} // namespace RC::Platform::Kbm
