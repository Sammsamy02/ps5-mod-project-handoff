+def _raw_bulk_map_region(d: bytes):
+    """(start, end) of the bulk-data map entries of a zen header, read with struct only."""
+    iph = struct.unpack_from("<i", d, 24)[0]
+    _n, _h, e = _raw_name_batch(d, 60, iph)
+    require(e + 8 <= iph, "substitute_raw_bulk_map_truncated")
+    pad = struct.unpack_from("<Q", d, e)[0]
+    require(pad < 8 and not any(d[e + 8:e + 8 + pad]), "substitute_raw_padding")
+    bpos = e + 8 + pad
+    size = struct.unpack_from("<q", d, bpos)[0]
+    require(size >= 0 and size % 32 == 0 and bpos + 8 + size == iph, "substitute_raw_bulk_map_truncated")
+    return bpos + 8, bpos + 8 + size
+
