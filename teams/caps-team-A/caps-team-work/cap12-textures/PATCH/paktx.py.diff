+def _can_draw(start: int, entries: dict, depth: int = 16) -> bool:
+    """True if the package or anything it imports (transitively, merged mod + base stores)
+    has shader maps: an instance without its own shader maps draws with its parent's."""
+    seen, frontier = set(), [start]
+    for _ in range(depth):
+        nxt = []
+        for p_ in frontier:
+            if p_ in seen:
+                continue
+            seen.add(p_)
+            e = entries.get(p_)
+            if e is None:
+                return True        # unknown package: cannot prove it does not draw (fail closed)
+            if e.shader_map_hashes:
+                return True
+            nxt.extend(e.imported_packages)
+        frontier = nxt
+        if not frontier:
+            return False
+    return True
+
