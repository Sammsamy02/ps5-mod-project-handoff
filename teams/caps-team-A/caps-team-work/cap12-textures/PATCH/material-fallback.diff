diff -ruN a/bcn_decode.py b/bcn_decode.py
--- a/bcn_decode.py	1969-12-31 18:00:00
+++ b/bcn_decode.py	2026-10-13 13:54:15
@@ -0,0 +1,277 @@
+#!/usr/bin/env python3
+"""Reference decoder for BC1 / BC2 / BC3 / BC7 blocks and 8-bit RGBA pixels
+(Mac-only, read-only, generic). Written separately from bcn_swap.py (no shared
+code) from the public Microsoft D3D10/11 block-compression specification; it is
+one of the two independent decoders of the R<->B swap proof (the other is the
+GPU: metal_bcn_check.swift). Its BC7 tables are cross-checked against the GPU
+in the tests.
+
+decode_block(fmt, block) -> 64 bytes: 16 texels x RGBA8, texel order row-major
+inside the 4x4 block. decode(fmt, data) yields one 64-byte string per block
+(per 4x4 group for the uncompressed formats: one texel per 'block').
+
+swap_proof(fmt, before, after) -> facts: decodes EVERY block of both inputs
+and checks after == before with R and B exchanged on every texel (all 16
+texels of every block, i.e. also the padding texels of mips smaller than 4x4).
+"""
+
+BC7_P2 = [
+    0xCCCC, 0x8888, 0xEEEE, 0xECC8, 0xC880, 0xFEEC, 0xFEC8, 0xEC80, 0xC800, 0xFFEC, 0xFE80, 0xE800,
+    0xFFE8, 0xFF00, 0xFFF0, 0xF000, 0xF710, 0x008E, 0x7100, 0x08CE, 0x008C, 0x7310, 0x3100, 0x8CCE,
+    0x088C, 0x3110, 0x6666, 0x366C, 0x17E8, 0x0FF0, 0x718E, 0x399C, 0xAAAA, 0xF0F0, 0x5A5A, 0x33CC,
+    0x3C3C, 0x55AA, 0x9696, 0xA55A, 0x73CE, 0x13C8, 0x324C, 0x3BDC, 0x6996, 0xC33C, 0x9966, 0x0660,
+    0x0272, 0x04E4, 0x4E40, 0x2720, 0xC936, 0x936C, 0x39C6, 0x639C, 0x9336, 0x9CC6, 0x817E, 0xE718,
+    0xCCF0, 0x0FCC, 0x7744, 0xEE22]
+
+BC7_P3 = [
+    "0011001102212222", "0001001122112221", "0000200122112211", "0222002200110111",
+    "0000000011221122", "0011001100220022", "0022002211111111", "0011001122112211",
+    "0000000011112222", "0000111111112222", "0000111122222222", "0012001200120012",
+    "0112011201120112", "0122012201220122", "0011011211221222", "0011200122002220",
+    "0001001101121122", "0111001120012200", "0000112211221122", "0022002200221111",
+    "0111011102220222", "0001000122212221", "0000001101220122", "0000110022102210",
+    "0122012200110000", "0012001211222222", "0110122112210110", "0000011012211221",
+    "0022110211020022", "0110011020022222", "0011012201220011", "0000200022112221",
+    "0000000211221222", "0222002200120011", "0011001200220222", "0120012001200120",
+    "0000111122220000", "0120120120120120", "0120201212010120", "0011220011220011",
+    "0011112222000011", "0101010122222222", "0000000021212121", "0022112200221122",
+    "0022001100220011", "0220122102201221", "0101222222220101", "0000212121212121",
+    "0101010101012222", "0222011102220111", "0002111200021112", "0000211221122112",
+    "0222011101110222", "0002111211120002", "0110011001102222", "0000000021122112",
+    "0110011022222222", "0022001100110022", "0022112211220022", "0000000000002112",
+    "0002000100020001", "0222122202221222", "0101222222222222", "0111201122012220"]
+
+BC7_A2 = [15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15,
+          15, 2, 8, 2, 2, 8, 8, 15, 2, 8, 2, 2, 8, 8, 2, 2,
+          15, 15, 6, 8, 2, 8, 15, 15, 2, 8, 2, 2, 2, 15, 15, 6,
+          6, 2, 6, 8, 15, 15, 2, 2, 15, 15, 15, 15, 15, 2, 2, 15]
+BC7_A3B = [3, 3, 15, 15, 8, 3, 15, 15, 8, 8, 6, 6, 6, 5, 3, 3,
+           3, 3, 8, 15, 3, 3, 6, 10, 5, 8, 8, 6, 8, 5, 15, 15,
+           8, 15, 3, 5, 6, 10, 8, 15, 15, 3, 15, 5, 15, 15, 15, 15,
+           3, 15, 5, 5, 5, 8, 5, 10, 5, 10, 8, 13, 15, 12, 3, 3]
+BC7_A3C = [15, 8, 8, 3, 15, 15, 3, 8, 15, 15, 15, 15, 15, 15, 15, 8,
+           15, 8, 15, 3, 15, 8, 15, 8, 3, 15, 6, 10, 15, 15, 10, 8,
+           15, 3, 15, 10, 10, 8, 9, 10, 6, 15, 8, 15, 3, 6, 6, 8,
+           15, 3, 15, 15, 15, 15, 15, 15, 15, 15, 15, 15, 3, 15, 15, 8]
+WEIGHTS = {2: (0, 21, 43, 64), 3: (0, 9, 18, 27, 37, 46, 55, 64),
+           4: (0, 4, 9, 13, 17, 21, 26, 30, 34, 38, 43, 47, 51, 55, 60, 64)}
+# mode: subsets, partition bits, rotation bits, idx-select bits, colour bits, alpha bits,
+#       per-endpoint p-bits, shared p-bits, index bits, second index bits
+MODES = [(3, 4, 0, 0, 4, 0, 1, 0, 3, 0), (2, 6, 0, 0, 6, 0, 0, 1, 3, 0),
+         (3, 6, 0, 0, 5, 0, 0, 0, 2, 0), (2, 6, 0, 0, 7, 0, 1, 0, 2, 0),
+         (1, 0, 2, 1, 5, 6, 0, 0, 2, 3), (1, 0, 2, 0, 7, 8, 0, 0, 2, 2),
+         (1, 0, 0, 0, 7, 7, 1, 0, 4, 0), (2, 6, 0, 0, 5, 5, 1, 0, 2, 0)]
+
+
+class DecodeError(ValueError):
+    pass
+
+
+def _subset_of(ns, part, i):
+    if ns == 1:
+        return 0
+    if ns == 2:
+        return (BC7_P2[part] >> i) & 1
+    return ord(BC7_P3[part][i]) - 48
+
+
+def _anchors(ns, part):
+    if ns == 1:
+        return (0,)
+    if ns == 2:
+        return (0, BC7_A2[part])
+    return (0, BC7_A3B[part], BC7_A3C[part])
+
+
+def _expand(v, bits):
+    v <<= 8 - bits
+    return v | (v >> bits)
+
+
+def _bc7(block):
+    v = int.from_bytes(block, 'little')
+    mode = None
+    for m in range(8):
+        if v >> m & 1:
+            mode = m
+            break
+    if mode is None:
+        return bytes(64)  # reserved: the spec decodes all channels to zero
+    ns, pbits, rbits, isbits, cbits, abits, epb, spb, ib, ib2 = MODES[mode]
+    pos = mode + 1
+
+    def take(n):
+        nonlocal pos
+        x = (v >> pos) & ((1 << n) - 1)
+        pos += n
+        return x
+    part = take(pbits)
+    rot = take(rbits)
+    isel = take(isbits)
+    ne = 2 * ns
+    ep = [[0, 0, 0, 255] for _ in range(ne)]
+    for ch in range(3):
+        for e in range(ne):
+            ep[e][ch] = take(cbits)
+    if abits:
+        for e in range(ne):
+            ep[e][3] = take(abits)
+    pv = [0] * ne
+    if epb:
+        for e in range(ne):
+            pv[e] = take(1)
+    elif spb:
+        for s in range(ns):
+            b = take(1)
+            pv[2 * s] = pv[2 * s + 1] = b
+    total_c = cbits + (1 if (epb or spb) else 0)
+    total_a = abits + (1 if (epb or spb) else 0) if abits else 0
+    for e in range(ne):
+        for ch in range(3):
+            x = ep[e][ch]
+            if epb or spb:
+                x = (x << 1) | pv[e]
+            ep[e][ch] = _expand(x, total_c)
+        if abits:
+            x = ep[e][3]
+            if epb or spb:
+                x = (x << 1) | pv[e]
+            ep[e][3] = _expand(x, total_a)
+    anc = _anchors(ns, part)
+    sub = [_subset_of(ns, part, i) for i in range(16)]
+    idx1 = []
+    for i in range(16):
+        n = ib - 1 if i in anc else ib
+        idx1.append(take(n))
+    idx2 = []
+    if ib2:
+        for i in range(16):
+            n = ib2 - 1 if i == 0 else ib2
+            idx2.append(take(n))
+    if pos != 128:
+        raise DecodeError(f'BC7 mode {mode}: {pos} bits consumed, need 128')
+    out = bytearray(64)
+    for i in range(16):
+        s = sub[i]
+        e0, e1 = ep[2 * s], ep[2 * s + 1]
+        if ib2:
+            if isel:
+                ci, cw = idx2[i], WEIGHTS[ib2]
+                ai, aw = idx1[i], WEIGHTS[ib]
+            else:
+                ci, cw = idx1[i], WEIGHTS[ib]
+                ai, aw = idx2[i], WEIGHTS[ib2]
+        else:
+            ci, cw = idx1[i], WEIGHTS[ib]
+            ai, aw = ci, cw
+        px = [((64 - cw[ci]) * e0[c] + cw[ci] * e1[c] + 32) >> 6 for c in range(3)]
+        px.append(((64 - aw[ai]) * e0[3] + aw[ai] * e1[3] + 32) >> 6)
+        if rot:
+            px[3], px[rot - 1] = px[rot - 1], px[3]
+        out[4 * i:4 * i + 4] = bytes(px)
+    return bytes(out)
+
+
+def _rgb565(c):
+    r, g, b = c >> 11, (c >> 5) & 63, c & 31
+    return ((r << 3) | (r >> 2), (g << 2) | (g >> 4), (b << 3) | (b >> 2))
+
+
+def _colour(b, force_four):
+    c0 = int.from_bytes(b[0:2], 'little')
+    c1 = int.from_bytes(b[2:4], 'little')
+    bits = int.from_bytes(b[4:8], 'little')
+    p0, p1 = _rgb565(c0), _rgb565(c1)
+    if force_four or c0 > c1:
+        pal = [p0 + (255,), p1 + (255,),
+               tuple((2 * p0[k] + p1[k]) // 3 for k in range(3)) + (255,),
+               tuple((p0[k] + 2 * p1[k]) // 3 for k in range(3)) + (255,)]
+    else:
+        pal = [p0 + (255,), p1 + (255,), tuple((p0[k] + p1[k]) // 2 for k in range(3)) + (255,), (0, 0, 0, 0)]
+    return [pal[(bits >> (2 * i)) & 3] for i in range(16)]
+
+
+def _bc3_alpha(b):
+    a0, a1 = b[0], b[1]
+    bits = int.from_bytes(b[2:8], 'little')
+    if a0 > a1:
+        pal = [a0, a1] + [((7 - k) * a0 + k * a1) // 7 for k in range(1, 7)]
+    else:
+        pal = [a0, a1] + [((5 - k) * a0 + k * a1) // 5 for k in range(1, 5)] + [0, 255]
+    return [pal[(bits >> (3 * i)) & 7] for i in range(16)]
+
+
+def decode_block(fmt, block):
+    if fmt == 'PF_DXT1':
+        px = _colour(block, False)
+        return b''.join(bytes(p) for p in px)
+    if fmt == 'PF_DXT3':
+        col = _colour(block[8:16], True)
+        al = int.from_bytes(block[0:8], 'little')
+        return b''.join(bytes(p[:3]) + bytes(((al >> (4 * i)) & 15) * 17 for _ in (0,)) for i, p in enumerate(col))
+    if fmt == 'PF_DXT5':
+        col = _colour(block[8:16], True)
+        al = _bc3_alpha(block[0:8])
+        return b''.join(bytes(p[:3]) + bytes((al[i],)) for i, p in enumerate(col))
+    if fmt == 'PF_BC7':
+        return _bc7(block)
+    if fmt == 'PF_B8G8R8A8':
+        return bytes((block[2], block[1], block[0], block[3]))
+    if fmt == 'PF_R8G8B8A8':
+        return bytes(block[0:4])
+    raise DecodeError(f'no decoder for {fmt}')
+
+
+BLOCK = {'PF_DXT1': 8, 'PF_DXT3': 16, 'PF_DXT5': 16, 'PF_BC7': 16, 'PF_B8G8R8A8': 4, 'PF_R8G8B8A8': 4}
+
+
+def decode(fmt, data):
+    bb = BLOCK.get(fmt)
+    if bb is None:
+        raise DecodeError(f'no decoder for {fmt}')
+    if len(data) % bb:
+        raise DecodeError('not a whole number of blocks')
+    for o in range(0, len(data), bb):
+        yield decode_block(fmt, data[o:o + bb])
+
+
+def _rb_swapped(texels):
+    t = bytearray(texels)
+    t[0::4] = texels[2::4]
+    t[2::4] = texels[0::4]
+    return bytes(t)
+
+
+def swap_proof(fmt, before, after):
+    """Decode every block of both; after must equal before with R<->B on every texel."""
+    bb = BLOCK.get(fmt)
+    if bb is None:
+        raise DecodeError(f'no decoder for {fmt}')
+    if len(before) != len(after) or len(before) % bb or not before:
+        raise DecodeError('inputs differ in size, are empty, or are not whole blocks')
+    texels = 0
+    differs = 0
+    bad = 0
+    first_bad = None
+    seen = {}
+    for o in range(0, len(before), bb):
+        a = before[o:o + bb]
+        b = after[o:o + bb]
+        key = a + b
+        res = seen.get(key)
+        if res is None:
+            da = decode_block(fmt, a)
+            db = decode_block(fmt, b)
+            res = (db == _rb_swapped(da), sum(1 for i in range(0, len(da), 4) if da[i] != da[i + 2]))
+            if len(seen) < 1 << 20:
+                seen[key] = res
+        n = 16 if bb > 4 else 1
+        texels += n
+        differs += res[1]
+        if not res[0]:
+            bad += 1
+            if first_bad is None:
+                first_bad = o
+    return {'decoder': 'bcn_decode.py (reference, D3D spec)', 'format': fmt, 'blocks': len(before) // bb,
+            'texels_compared': texels, 'texels_where_r_differs_from_b': differs,
+            'mismatched_blocks': bad, 'first_mismatch_offset': first_bad, 'exact': bad == 0 and texels > 0}
diff -ruN a/bcn_swap.py b/bcn_swap.py
--- a/bcn_swap.py	1969-12-31 18:00:00
+++ b/bcn_swap.py	2026-10-13 13:54:15
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Exact red<->blue channel swap on COMPRESSED texture blocks (Mac-only, generic).
+
+Capability #12 "derived texture" (user/integrator decision 2026-10-13): a mod
+packed mask whose channel order is the R<->B mirror of the game slot's order
+(e.g. ORM = O,R,M in R,G,B versus MRO = M,R,O) is made usable by swapping the
+red and blue channels of the mod texture. The swap works on the stored blocks
+(no decode / re-encode, never lossy). Output decodes to exactly the input with
+R and B exchanged on every texel for any decoder that treats the 5-bit red and
+5-bit blue fields the same way AND (BC1-3 blocks whose endpoints get exchanged)
+whose 1/3-2/3 blend is mirror-symmetric. The D3D spec does not require bit-exact
+BC1-3 interpolation, so exactness is PROVEN for the two decoders used (bcn_decode.py,
+spec integer rounding, and the Mac GPU, metal_bcn_check.swift), not for every GPU;
+a decoder with an asymmetric blend could differ by at most one 8-bit step on those
+blocks. BC7 and 8-bit RGBA are exact for every decoder (integer-specified).
+
+Public format facts only (Microsoft D3D10/11 block-compression specification,
+BC1/BC2/BC3/BC7 layouts). No Sony material, no game or mod names.
+
+Formats (UE pixel-format names) and what is done:
+  PF_DXT1 (BC1)  colour endpoints RGB565: R (bits 11-15) and B (bits 0-4) of
+                 both endpoints are exchanged. The block MODE depends on the
+                 unsigned comparison c0 > c1 (4-colour) versus c0 <= c1
+                 (3-colour + transparent black), and the swap can flip that
+                 comparison. When it does, the two endpoints are exchanged and
+                 the indices remapped so the mode and every palette entry stay
+                 the same: 4-colour 0<->1, 2<->3; 3-colour 0<->1 (2 = midpoint
+                 and 3 = transparent black stay).
+  PF_DXT3 (BC2), PF_DXT5 (BC3)
+                 alpha half unchanged; colour half as BC1, but the spec decodes
+                 it ALWAYS as 4-colour while some decoders use the c0 <= c1
+                 rule. The ordering of c0/c1 is preserved, so both readings stay
+                 exact; the one case where no single output is exact under both
+                 readings (c0 < c1, the swap flips the order, and index 2 or 3 is
+                 used) is REFUSED.
+  PF_BC7         the R and B endpoint fields (equal width in every mode, p-bits
+                 are per endpoint for all channels) are exchanged; in modes 4
+                 and 5 the rotation field maps 1 (swap A,R) <-> 3 (swap A,B).
+                 Reserved mode (first byte 0) is REFUSED.
+  PF_B8G8R8A8, PF_R8G8B8A8
+                 bytes 0 and 2 of every pixel are exchanged.
+Anything else (BC4/BC5 have no blue channel, BC6H, float formats ...) is REFUSED.
+"""
+
+SUPPORTED = ('PF_DXT1', 'PF_DXT3', 'PF_DXT5', 'PF_BC7', 'PF_B8G8R8A8', 'PF_R8G8B8A8')
+BLOCK_BYTES = {'PF_DXT1': 8, 'PF_DXT3': 16, 'PF_DXT5': 16, 'PF_BC7': 16, 'PF_B8G8R8A8': 4, 'PF_R8G8B8A8': 4}
+
+# BC7 per mode: (subsets, partition bits, rotation bits, index-selection bits, colour bits)
+BC7_MODES = {0: (3, 4, 0, 0, 4), 1: (2, 6, 0, 0, 6), 2: (3, 6, 0, 0, 5), 3: (2, 6, 0, 0, 7),
+             4: (1, 0, 2, 1, 5), 5: (1, 0, 2, 0, 7), 6: (1, 0, 0, 0, 7), 7: (2, 6, 0, 0, 5)}
+
+
+class SwapRefused(ValueError):
+    pass
+
+
+def _swap565(c):
+    return ((c & 0x1F) << 11) | (c & 0x07E0) | (c >> 11)
+
+
+def _colour_block(b, always_four):
+    """8-byte BC1-style colour block -> swapped 8 bytes."""
+    c0 = b[0] | (b[1] << 8)
+    c1 = b[2] | (b[3] << 8)
+    idx = b[4] | (b[5] << 8) | (b[6] << 16) | (b[7] << 24)
+    s0, s1 = _swap565(c0), _swap565(c1)
+    four = c0 > c1
+    flips = c0 != c1 and (s0 > s1) != (c0 > c1)
+    if always_four and flips and c0 < c1 and {(idx >> (2 * k)) & 3 for k in range(16)} & {2, 3}:
+        raise SwapRefused('BC2/BC3 colour block c0 < c1 whose endpoint order flips, with index 2/3: no output is '
+                          'exact under both the 4-colour and the 3-colour reading')
+    if not flips:
+        n0, n1, nidx = s0, s1, idx
+    else:
+        # comparison flipped: exchange the endpoints and remap the indices
+        n0, n1 = s1, s0
+        nidx = 0
+        for k in range(16):
+            x = (idx >> (2 * k)) & 3
+            if four:
+                y = x ^ 1                    # 0<->1, 2<->3
+            else:
+                y = x ^ 1 if x < 2 else x    # 0<->1; 2 (midpoint), 3 (transparent) stay
+            nidx |= y << (2 * k)
+        if not (c0 == c1 or (n0 > n1) == (c0 > c1)):
+            raise SwapRefused('internal: endpoint order not preserved')
+    return bytes((n0 & 0xFF, n0 >> 8, n1 & 0xFF, n1 >> 8,
+                  nidx & 0xFF, (nidx >> 8) & 0xFF, (nidx >> 16) & 0xFF, nidx >> 24))
+
+
+def bc7_mode(block):
+    b0 = block[0]
+    for m in range(8):
+        if b0 & (1 << m):
+            return m
+    return None
+
+
+def _bc7_block(block):
+    m = bc7_mode(block)
+    if m is None:
+        raise SwapRefused('BC7 reserved mode (first byte 0)')
+    ns, pb, rb, isb, cb = BC7_MODES[m]
+    v = int.from_bytes(block, 'little')
+    pos = m + 1 + pb
+    if rb:
+        rot = (v >> pos) & 3
+        nrot = {0: 0, 1: 3, 2: 2, 3: 1}[rot]
+        v = (v & ~(3 << pos)) | (nrot << pos)
+    start = m + 1 + pb + rb + isb
+    w = 2 * ns * cb
+    mask = (1 << w) - 1
+    r = (v >> start) & mask
+    bl = (v >> (start + 2 * w)) & mask
+    v &= ~((mask << start) | (mask << (start + 2 * w)))
+    v |= (bl << start) | (r << (start + 2 * w))
+    return v.to_bytes(16, 'little')
+
+
+def swap_rb(fmt, data):
+    """-> (swapped bytes, facts). Raises SwapRefused for anything not exact."""
+    if fmt not in SUPPORTED:
+        raise SwapRefused(f'pixel format {fmt} not supported for an exact R<->B swap')
+    bb = BLOCK_BYTES[fmt]
+    if len(data) % bb:
+        raise SwapRefused(f'{len(data)} bytes is not a whole number of {bb}-byte {fmt} blocks')
+    out = bytearray(len(data))
+    facts = {'format': fmt, 'blocks': len(data) // bb, 'endpoint_order_fixed': 0, 'bc7_rotation_remapped': 0}
+    mv = memoryview(data)
+    if fmt in ('PF_B8G8R8A8', 'PF_R8G8B8A8'):
+        out[:] = data
+        out[0::4] = data[2::4]
+        out[2::4] = data[0::4]
+        return bytes(out), facts
+    cache = {}
+    for o in range(0, len(data), bb):
+        blk = bytes(mv[o:o + bb])
+        got = cache.get(blk)
+        if got is None:
+            if fmt == 'PF_DXT1':
+                got = _colour_block(blk, False)
+                fixed = got[0:2] != _swap565(blk[0] | (blk[1] << 8)).to_bytes(2, 'little')
+            elif fmt in ('PF_DXT3', 'PF_DXT5'):
+                got = blk[:8] + _colour_block(blk[8:], True)
+                fixed = got[8:10] != _swap565(blk[8] | (blk[9] << 8)).to_bytes(2, 'little')
+            else:
+                got = _bc7_block(blk)
+                m = bc7_mode(blk)
+                fixed = m in (4, 5) and ((int.from_bytes(blk, 'little') >> (m + 1)) & 3) in (1, 3)
+            got = (got, fixed)
+            if len(cache) < 1 << 20:
+                cache[blk] = got
+        out[o:o + bb] = got[0]
+        if got[1]:
+            facts['endpoint_order_fixed' if fmt != 'PF_BC7' else 'bc7_rotation_remapped'] += 1
+    return bytes(out), facts
