+def find_original_master(pkg, overridden, game_imports, cls_of, master_paths, depth=MAX_DEPTH):
+    """The GAME's own parent chain of a package the mod overrides (game store graph only).
+    game_imports: {package: set(imported game packages)}; master_paths(master) -> (paths list | None, why).
+    -> {'master', 'tokens'} or {'why'[, 'master']} (fail closed on anything not exactly one chain)."""
+    if pkg not in overridden:
+        return {'why': 'not an override of a game package'}
+    cur, seen = pkg, {pkg}
+    for _ in range(depth):
+        mats = sorted(q for q in game_imports.get(cur, ()) if cls_of(q) in (INSTANCE, 'Material'))
+        if len(mats) != 1:
+            return {'why': '%d material imports in the game chain at %s' % (len(mats), cur)}
+        cur = mats[0]
+        if cur in seen:
+            return {'why': 'cyclic game chain'}
+        seen.add(cur)
+        if cls_of(cur) == 'Material':
+            toks, why = master_paths(cur)
+            if toks is None:
+                return {'master': cur, 'why': why}
+            if not any('VertexFactory' in t for t in toks):
+                return {'master': cur, 'why': 'no vertex-factory layout in the master'}
+            return {'master': cur, 'tokens': sorted(toks)}
+    return {'why': 'game chain deeper than %d' % depth}
+
