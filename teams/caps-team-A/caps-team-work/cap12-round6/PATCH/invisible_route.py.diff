+def lp_names(blob):
+    """Length-prefixed, NUL-terminated ASCII type names (int32 length incl. the NUL, the name, NUL), the
+    form the frozen shader-map content stores its type-layout names in. Anything else is ignored."""
+    out = set()
+    b = blob or b''
+    for m in LP_NAME_RE.finditer(b):
+        st, en = m.start(), m.end()
+        if st >= 4 and en < len(b) and b[en] == 0 and int.from_bytes(b[st - 4:st], 'little') == en - st + 1:
+            out.add(m.group().decode('ascii'))
+    return out
+
+
+def vf_tokens(blob):
+    """Every vertex-factory layout name (any name containing 'VertexFactory', F- or T-prefixed) in a
+    material's own export bytes: its frozen PS5 shader-map content lists the parameter layout of every
+    vertex factory it was compiled for."""
+    return {n for n in lp_names(blob) if 'VertexFactory' in n}
+
+
+def drawing_paths(blob):
+    """vf_tokens + NANITE_PATH when the shader map holds Nanite compute base-pass shaders (TBasePassCS*),
+    which leave no vertex-factory layout name."""
+    names = lp_names(blob)
+    return {n for n in names if 'VertexFactory' in n} | ({NANITE_PATH} if any(n.startswith(NANITE_MARK)
+                                                                             for n in names) else set())
+
+
+def learn_vf_token(train, user_class, exclude=(), need_absent_in_static_only=False):
+    """train: [(package, vf token set, user classes)] of game Materials. -> {'token', 'trained', 'why'}:
+    the ONE token present in every material with a `user_class` user (and, for the skeletal check, absent
+    in >= MIN_ST_ABSENT static-only materials), learned without `exclude`."""
+    pos = [t for pkg, t, u in train if pkg not in exclude and user_class in u]
+    st = [t for pkg, t, u in train if pkg not in exclude and u == {STATIC}]
+    if len(pos) < MIN_VF_TRAIN:
+        return {'token': None, 'trained': len(pos), 'why': f'only {len(pos)} game materials with a {user_class} user '
+                                                             f'(need {MIN_VF_TRAIN})'}
+    common = set.intersection(*pos)
+    if need_absent_in_static_only:
+        common = {k for k in common if sum(1 for t in st if k not in t) >= MIN_ST_ABSENT}
+    if len(common) != 1:
+        return {'token': None, 'trained': len(pos), 'why': f'{len(common)} tokens fit (need exactly 1): {sorted(common)[:6]}'}
+    tok = next(iter(common))
+    return {'token': tok, 'trained': len(pos), 'static_only_absent': sum(1 for t in st if tok not in t)}
+
+
+def static_proof(f):
+    """G6 for one game target. f['vf']: {'tokens', 'static', 'static_global', 'skeletal'}.
+    Sources: (1) its own PS5 shader map lists the static-mesh vertex-factory layout; (2) engine rule: the
+    engine compiles its static-mesh vertex factory for every MD_Surface material, and G3 proved MD_Surface
+    (two-source class). The learned token is a name-consistency check only (it is in every material).
+    Scope: a plain static-mesh draw; Nanite, instanced, spline and geometry-collection draws are other paths.
+    -> (proven: bool, why or sources)."""
+    vf = f.get('vf') or {}
+    toks = vf.get('tokens')
+    if toks is None:
+        return False, 'own export unreadable for vertex-factory tokens'
+    if (f.get('two_source_class') or {}).get('domain') != 'MD_Surface':
+        return False, 'engine rule needs a two-source MD_Surface domain'
+    lt, lg = vf.get('static') or {}, vf.get('static_global') or {}
+    if not lt.get('token'):
+        return False, 'static-mesh token not learned: ' + str(lt.get('why'))
+    if lt['token'] != lg.get('token'):
+        return False, f"static-mesh token learned without it ({lt['token']}) differs from all ({lg.get('token')})"
+    if lt['token'] != VF_PARAMS[STATIC]:
+        return False, f"learned static-mesh token {lt['token']} is not the engine's {VF_PARAMS[STATIC]}"
+    if lt['token'] not in toks:
+        return False, f"its own shader map lacks {lt['token']}"
+    sk = vf.get('skeletal') or {}
+    if sk.get('token') != VF_PARAMS[SKELETAL] or VF_PARAMS[SKELETAL] not in toks:
+        return False, ('method check failed: the skeletal vertex-factory token is not learned as '
+                       f"{VF_PARAMS[SKELETAL]} or is absent although G5 proved skeletal use")
+    return True, {'own_shader_map': f"own PS5 shader map lists {lt['token']} (the static-mesh vertex factory's "
+                                    'parameter layout)',
+                  'engine_rule': 'the engine compiles the static-mesh vertex factory for every MD_Surface '
+                                 'material; MD_Surface proven by registry + compiled shader types (G3)',
+                  'name_check': f"the layout name is the one present in all {lt['trained']} game materials drawn "
+                                'by game StaticMeshes (learned without it; consistency only)',
+                  'method_check': f"skeletal layout learned the same way = {sk.get('token')} (agrees with G5)",
+                  'scope': 'plain static-mesh draws only: Nanite, instanced, spline and geometry-collection '
+                           'draws are other paths and are not proven'}
+
