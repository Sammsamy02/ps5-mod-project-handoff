+	do {	\
+		void **__p = (void **) mono_array_addr ((dest), void*, (destidx));	\
+		void **__s = mono_array_addr ((src), void*, (srcidx));	\
+		mono_gc_wbarrier_arrayref_copy (__p, __s, (count));	\
