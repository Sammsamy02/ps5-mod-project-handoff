+    struct Result
+    {
+        Cap10Boundary::Report calls{};
+        Stage stage{Stage::NotStarted};
+        bool initialized{}, exact_image{}, resolver_load{}, resolver_abi{}, resolver_probe{}, completed{};
+    };
