+    // ---- ASCII fold (case-insensitive OK check; NO wcsicmp/towlower) ----
+    inline auto ascii_fold_unit(CharType c) -> CharType
+    {
+        const auto v = static_cast<uint32_t>(c);
+        return (v >= 'A' && v <= 'Z') ? static_cast<CharType>(v - 'A' + 'a') : c;
+    }
