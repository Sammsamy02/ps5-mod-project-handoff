--- a/configure.ac
+++ b/configure.ac
@@ -141,6 +141,17 @@
 build_darwin=no
 
 case "$host" in
+	x86_64-sie-ps5)
+		# Prospero platform characteristics: begin
+		# The public compiler supplies the FreeBSD ABI macros. Do not invent
+		# OS macros or inherit a desktop /usr/local search path or -lutil.
+		CPPFLAGS="$CPPFLAGS -DHOST_BSD -DGC_FREEBSD_THREADS -D_WITH_GETLINE"
+		libgc_threads=pthreads
+		need_link_unlink=yes
+		use_sigposix=yes
+		AC_DEFINE(PTHREAD_POINTER_ID, 1, [pthread is a pointer])
+		# Prospero platform characteristics: end
+		;;
 	wasm32*)
 		CFLAGS="$CFLAGS -D_REENTRANT -D_GNU_SOURCE -s WASM=1"
 		CPPFLAGS="$CPPFLAGS -D_REENTRANT -DUSE_MMAP -s WASM=1"
@@ -1025,7 +1036,46 @@
 
 # Enable support for fast thread-local storage
 # Some systems have broken support, so we allow to disable it.
-AC_ARG_WITH(tls, [  --with-tls=__thread,pthread    select Thread Local Storage implementation (defaults to __thread)],[],[with_tls=__thread])
+mono_tls_explicit=no
+AC_ARG_WITH(tls, [  --with-tls=__thread,pthread    select Thread Local Storage implementation (defaults to __thread; pthread on Prospero)], [mono_tls_explicit=yes], [with_tls=__thread])
+
+AC_MSG_CHECKING([whether the compiler targets Prospero])
+AC_COMPILE_IFELSE([AC_LANG_SOURCE([[
+#ifndef __PROSPERO__
+#error not a Prospero compiler
+#endif
+int main (void) { return 0; }
+]])], [host_prospero=yes], [host_prospero=no])
+AC_MSG_RESULT([$host_prospero])
+
+# Prospero compiler identity guard: begin
+case "$host" in
+    x86_64-sie-ps5)
+        if test "x$host_prospero" != "xyes"; then
+            AC_MSG_ERROR([x86_64-sie-ps5 requires a genuine Prospero compiler])
+        fi
+        ;;
+    *-*-ps5*)
+        AC_MSG_ERROR([only x86_64-sie-ps5 is configured for the public target])
+        ;;
+    *)
+        if test "x$host_prospero" = "xyes"; then
+            AC_MSG_ERROR([use --host=x86_64-sie-ps5 with the Prospero compiler])
+        fi
+        ;;
+esac
+# Prospero compiler identity guard: end
+
+# Prospero TLS policy: begin
+if test "x$host_prospero" = "xyes"; then
+    # The public target wrapper uses emulated TLS, which has no FS-relative
+    # offsets. Use Mono's existing pthread-key implementation instead.
+    if test "x$mono_tls_explicit" = "xyes" -a "x$with_tls" != "xpthread"; then
+        AC_MSG_ERROR([Prospero requires --with-tls=pthread])
+    fi
+    with_tls=pthread
+fi
+# Prospero TLS policy: end
 
 # Enable support for using sigaltstack for SIGSEGV and stack overflow handling
 # This does not work on some platforms (bug #55253)
@@ -2253,6 +2303,7 @@
 	AC_CHECK_FUNCS(getpriority)
 	AC_CHECK_FUNCS(setpriority)
 	AC_CHECK_FUNCS(dl_iterate_phdr)
+	AC_CHECK_FUNCS(kinfo_getfile)
 	AC_CHECK_FUNCS(dladdr)
 	AC_CHECK_FUNCS(sysconf)
 	AC_CHECK_FUNCS(getrlimit)
@@ -2765,6 +2816,13 @@
 	AC_CHECK_HEADERS(pthread_np.h)
 	AC_CHECK_FUNCS(pthread_mutex_timedlock)
 	AC_CHECK_FUNCS(pthread_getattr_np pthread_attr_get_np pthread_getname_np pthread_setname_np pthread_cond_timedwait_relative_np)
+	# A symbol-only import stub does not establish the public function ABI.
+	AC_CHECK_DECLS([pthread_getname_np], [], [], [[
+#include <pthread.h>
+#ifdef HAVE_PTHREAD_NP_H
+#include <pthread_np.h>
+#endif
+]])
 	AC_CHECK_FUNCS(pthread_kill pthread_jit_write_protect_np)
 	AC_MSG_CHECKING(for PTHREAD_MUTEX_RECURSIVE)
 	AC_TRY_COMPILE([ #include <pthread.h>], [
@@ -5196,6 +5254,18 @@
 
 AC_SEARCH_LIBS(sqrtf, m)
 
+# Keep established target flags, but use the measured dependency on Prospero.
+# The public compiler supplies math through its default C runtime libraries.
+MONO_MATH_LIBS="-lm"
+if test "x$host_prospero" = "xyes"; then
+    case "$ac_cv_search_sqrtf" in
+        "none required") MONO_MATH_LIBS= ;;
+        no) AC_MSG_ERROR([Prospero compiler cannot link the required sqrtf function]) ;;
+        *) MONO_MATH_LIBS="$ac_cv_search_sqrtf" ;;
+    esac
+fi
+AC_SUBST(MONO_MATH_LIBS)
+
 # nanosleep may not be part of libc, also search it in other libraries
 AC_SEARCH_LIBS(nanosleep, rt)
 
@@ -6573,6 +6643,20 @@
 	MONO_NATIVE_PLATFORM=aix
 
 	MONO_NATIVE_PLATFORM_TYPE="MONO_NATIVE_PLATFORM_TYPE_AIX"
+elif test "x$host" = "xx86_64-sie-ps5"; then
+	# Build the existing Unix/FreeBSD source set with genuine SDK headers.
+	# Do not report the unassigned Prospero platform as desktop FreeBSD.
+	mono_native_text="Prospero (public FreeBSD ABI source set)"
+	MONO_NATIVE_CC=$CC
+	MONO_NATIVE_CXX=$CXX
+	MONO_NATIVE_CPPFLAGS=$CPPFLAGS
+	MONO_NATIVE_CXXFLAGS=$CXXFLAGS
+	MONO_NATIVE_CFLAGS=$CFLAGS
+	MONO_NATIVE_LDFLAGS=$LDFLAGS
+	mono_native=yes
+	mono_native_compat=no
+	MONO_NATIVE_PLATFORM=freebsd
+	MONO_NATIVE_PLATFORM_TYPE="MONO_NATIVE_PLATFORM_TYPE_UNKNOWN"
 elif case $host_os in freebsd*) true;; *) false;; esac; then
 	mono_native_text="FreeBSD"
 	MONO_NATIVE_CC=$CC
