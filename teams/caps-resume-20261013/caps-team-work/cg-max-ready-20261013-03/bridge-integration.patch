-// call6: sysv a5,a6 at [rsp+8],[rsp+16] -> win slots [rsp+0x20],[rsp+0x28]
+// call6: SysV a5 is R9, a6 is [rsp_entry+8]; Win64 a5/a6 use stack slots.
 GLOBALFN(cap13_win64_call6)
-    mov  r10, [rsp + 8]
-    mov  r11, [rsp + 16]
-    sub  rsp, 0x28
-    mov  [rsp + 0x20], r10
-    mov  [rsp + 0x28], r11
+    mov  r10, [rsp + 8]         // read a6 before allocating the Win64 frame
+    sub  rsp, 0x38              // shadow + two slots + alignment; preserve our return address
+    mov  [rsp + 0x20], r9       // a5
+    mov  [rsp + 0x28], r10      // a6
     mov  rax, rdi
     mov  r9,  r8
     mov  r8,  rcx
     mov  rcx, rsi
     call rax
-    add  rsp, 0x28
+    add  rsp, 0x38
     ret
 
