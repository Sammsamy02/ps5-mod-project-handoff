-// call5: + sysv stack a5 at [rsp_entry+8]; win a5 belongs at [rsp+0x20]
+// call5: fn consumes SysV RDI, so a5 arrives in R9; Win64 a5 is on stack.
 GLOBALFN(cap13_win64_call5)
-    mov  r10, [rsp + 8]         // sysv a5 (read before dropping the frame)
     sub  rsp, 0x28
-    mov  [rsp + 0x20], r10      // win a5 slot (just above the shadow space)
+    mov  [rsp + 0x20], r9       // win a5 slot (just above the shadow space)
     mov  rax, rdi
