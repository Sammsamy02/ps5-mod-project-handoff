+    [[nodiscard]] bool FindXOfCache_TryFirstOf(FName ClassName, UObject*& OutObject)
+    {
+        OutObject = nullptr;
+        if (!FindXOfBucketsActive) { return false; }
+        const uint32_t Key = ClassName.GetComparisonIndex().ToUnstableInt();
+
+        std::lock_guard Lock(FindXOfBucketsMutex);
+        const auto BucketIt = FindXOfBuckets.find(Key);
+        if (BucketIt == FindXOfBuckets.end()) { return false; }
+
+        UObject* LastChainMatch = nullptr;
+        for (const FUObjectItem* Item : BucketIt->second.Items)
+        {
+            UObject* Object = Item->GetUObject();
+            if (!Object || Item->IsUnreachable()) { continue; }
+            if (Object->GetClassPrivate()->GetNamePrivate().Equals(ClassName))
+            {
+                // Walk rule: the first DIRECT match breaks the scan and wins,
+                // regardless of earlier chain matches.
+                OutObject = Object;
+                return true;
+            }
+            LastChainMatch = Object;
+        }
+        if (LastChainMatch)
+        {
+            OutObject = LastChainMatch;
+            return true;
+        }
+        return false;
+    }
+
+    [[nodiscard]] bool FindXOfCache_TryAllOf(FName ClassName, std::vector<UObject*>& OutStorage)
+    {
+        if (!FindXOfBucketsActive) { return false; }
+        const uint32_t Key = ClassName.GetComparisonIndex().ToUnstableInt();
+
+        std::lock_guard Lock(FindXOfBucketsMutex);
+        const auto BucketIt = FindXOfBuckets.find(Key);
+        if (BucketIt == FindXOfBuckets.end()) { return false; }
+
+        for (const FUObjectItem* Item : BucketIt->second.Items)
+        {
+            UObject* Object = Item->GetUObject();
+            if (!Object || Item->IsUnreachable()) { continue; }
+            OutStorage.emplace_back(Object);
+        }
+        return true;
+    }
