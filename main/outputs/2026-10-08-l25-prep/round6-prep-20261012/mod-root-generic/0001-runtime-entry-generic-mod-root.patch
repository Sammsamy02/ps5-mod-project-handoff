+/* String at j->i (must be '"'). Captures up to cap-1 bytes; *plain = 0 when
+ * it holds an escape or a non-ASCII byte; *truncated = 1 when it is longer
+ * than cap-1 bytes (the capture is then a prefix only). */
+static int mbt_json_string(mbt_json *j, char *capture, size_t cap, int *plain,
+                           int *truncated)
+{
+    size_t used = 0;
+    if (j->i >= j->n || j->p[j->i] != '"')
+        return 0;
+    ++j->i;
+    if (plain != NULL)
+        *plain = 1;
+    if (truncated != NULL)
+        *truncated = 0;
+    for (;;) {
+        unsigned char c;
+        if (j->i >= j->n)
+            return 0;
+        c = j->p[j->i++];
+        if (c == '"')
+            break;
+        if (c < 0x20)
+            return 0;
+        if (c == '\\') {
+            unsigned char e;
+            if (j->i >= j->n)
+                return 0;
+            e = j->p[j->i++];
+            if (e == 'u') {
+                unsigned k;
+                for (k = 0; k < 4; ++k) {
+                    if (j->i >= j->n || !mbt_hex(j->p[j->i]))
+                        return 0;
+                    ++j->i;
+                }
+            } else if (!(e == '"' || e == '\\' || e == '/' || e == 'b' ||
+                         e == 'f' || e == 'n' || e == 'r' || e == 't')) {
+                return 0;
+            }
+            if (plain != NULL)
+                *plain = 0;
+            continue;
+        }
+        if (c >= 0x80) {
+            if (!mbt_json_utf8(j, c))
+                return 0;
+            if (plain != NULL)
+                *plain = 0;
+            continue;
+        }
+        if (capture != NULL) {
+            if (used + 1 < cap)
+                capture[used++] = (char)c;
+            else if (truncated != NULL)
+                *truncated = 1;
+        }
+    }
+    if (capture != NULL && cap > 0)
+        capture[used < cap ? used : cap - 1] = '\0';
+    return 1;
+}
