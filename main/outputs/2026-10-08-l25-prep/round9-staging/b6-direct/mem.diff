+                }
+                else
+                {
+                    Output::send<LogLevel::Warning>(STR("[MEM] lua-backend=libc reason={} (fail-closed: Lua keeps the libc heap)\n"), reason);
+                }
+            }
+            catch (...)
+            {
+                // Observational only: a log failure never changes the decision.
+            }
+        }
