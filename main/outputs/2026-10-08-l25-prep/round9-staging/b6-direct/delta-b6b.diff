+    auto rebase_pristine_state_on_backing(Lua& lua) noexcept -> int
+    {
+        try
+        {
+            void* const backing_ud = backing_for_new_state();
+            if (backing_ud == nullptr)
+            {
+                return -1;
+            }
+            lua_State* const old_state = lua.m_lua_state;
+            void* old_ud = nullptr;
+            (void)lua_getallocf(old_state, &old_ud);
+            if (old_ud == backing_ud)
+            {
+                return 0;
+            }
+            // Pristine: empty stack and an empty global table (nothing registered yet).
+            if (lua_gettop(old_state) != 0)
+            {
+                return -2;
+            }
+            lua_pushglobaltable(old_state);
+            lua_pushnil(old_state);
+            const bool has_globals = lua_next(old_state, -2) != 0;
+            lua_settop(old_state, 0);
+            if (has_globals)
+            {
+                return -2;
+            }
+            auto node = lua_instances.extract(old_state);
+            if (node.empty())
+            {
+                return -2;
+            }
+            lua_State* const new_state_ptr = lua_newstate(lms_counting_alloc, backing_ud);
+            if (new_state_ptr == nullptr)
+            {
+                lua_instances.insert(std::move(node));
+                return -3;
+            }
+            g_backing_states.fetch_add(1);
+            lua_atpanic(new_state_ptr, &lms_lua_panic);
+            lua_setwarnf(new_state_ptr, lms_warnfoff, new_state_ptr);
+            lua.m_lua_state = new_state_ptr;
+            node.key() = new_state_ptr;
+            lua_instances.insert(std::move(node));
+            lua_close(old_state);
+            return 1;
+        }
+        catch (...)
+        {
+            return -3;
+        }
+    }
