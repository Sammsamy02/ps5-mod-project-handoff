+extern "C" int bridge_write_copyin_sink_bytes(const uint8_t **out_bytes, uint32_t *out_len)
+{
+    if (out_bytes == nullptr || out_len == nullptr || !g_write_copyin_sink_valid) {
+        return 0;
+    }
+    *out_bytes = g_write_copyin_sink_capture;
+    *out_len = g_write_copyin_sink_len;
+    return 1;
