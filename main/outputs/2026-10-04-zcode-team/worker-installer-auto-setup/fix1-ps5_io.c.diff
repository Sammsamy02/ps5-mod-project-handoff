 /* ---- shared semantic layer ------------------------------------------------ */
 
+/* Namespace-root auto-creation (console): a fresh console may not have the
+ * file I/O owner's production namespace root (PS5IO_NAMESPACE_ROOT); the
+ * console E2E run failed at stage 41 for exactly that reason and had to be
+ * repaired out-of-band (FTP MKD). The adapter therefore ensures the root
+ * exists on first open. Best-effort by design: a bootstrap failure is never
+ * forced onto an open that does not need the root (read-only opens, host
+ * tests); the real open then reports its own accurate errno. The composed
+ * installer additionally verifies/creates the root explicitly before any
+ * owner opens, so a genuine failure surfaces there with a named status. */
+static void ps5io_ensure_namespace_root(void); /* defined below ps5io_stat_path */
+
 int ps5io_open(const char *path, unsigned flags, unsigned mode)
 {
     if (!path || !path[0]) return -EINVAL;
+    ps5io_ensure_namespace_root();
     return os_open(path, (int)flags, mode);
 }
 
