+#ifndef PS5IO_HOST
+/* One-shot namespace-root bootstrap, console builds only. The installer core
+ * is single-threaded, so a plain once-flag is sufficient. Host builds get a
+ * no-op so host tests never create console namespaces on the host. */
+static void ps5io_ensure_namespace_root(void)
+{
+    static int attempted;
+    ps5io_stat st;
+    if (attempted) return;
+    attempted = 1;
+    if (ps5io_stat_path(PS5IO_NAMESPACE_ROOT, &st) == 0 && st.exists
+        && st.is_dir == 1)
+        return;
+    (void)ps5io_mkdir_p(PS5IO_NAMESPACE_ROOT, 0755);
+}
+#else
+static void ps5io_ensure_namespace_root(void)
+{
+    /* host: no-op (never create the console namespace on the host) */
+}
+#endif
