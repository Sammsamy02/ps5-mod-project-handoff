+        if (v >= 0x7ebc000ull && v < 0x9633418ull) { return SeedAddressClass::DataReadable; }   // LOAD3+LOAD7 RW-
+        return SeedAddressClass::Refused;                                                       // gaps + LOAD8 ---
+    }
