+/* CreateMutexA: CP_ACP single-byte name. Adapter policy on the PS5 target
+ * (no codepage tables / no locale): every ANSI byte is zero-extended into
+ * one UTF-16 code unit (verbatim byte->WCHAR cast); NULL stays NULL. The
+ * converted name is handed to the same wide path, so every object-namespace
+ * rule (Local\ prefix, backslash refusal, 260-unit MAX_PATH bound, ASCII
+ * case folding) and its documented error is enforced exactly once, by the
+ * wide path's parse_name. A name too long for the conversion buffer is
+ * deliberately passed unterminated at MB_WIN_MUTEX_MAX_NAME+1 units so
+ * parse_name itself fails ERROR_FILENAME_EXCED_RANGE exactly like it does
+ * for the W entry point. */
+static WIN64 void *create_mutex_a(void *security,int32_t initial_owner,const char *name){
+    (void)security;
+    if(!name)return (void*)(uintptr_t)mb_win_mutex_create(installed,NULL,initial_owner?MB_WIN_MUTEX_INITIAL_OWNER:0);
+    uint16_t wide[MB_WIN_MUTEX_MAX_NAME+1];
+    size_t units=0;
+    while(name[units]&&units<=(size_t)MB_WIN_MUTEX_MAX_NAME){wide[units]=(uint16_t)(unsigned char)name[units];++units;}
+    if(units<=(size_t)MB_WIN_MUTEX_MAX_NAME)wide[units]=0;
+    return (void*)(uintptr_t)mb_win_mutex_create(installed,wide,initial_owner?MB_WIN_MUTEX_INITIAL_OWNER:0);
+}
 static WIN64 void *create_mutex_ex_w(void *security,const uint16_t *name,uint32_t flags,uint32_t desired_access){
     (void)security;(void)desired_access;
     return (void*)(uintptr_t)mb_win_mutex_create(installed,name,flags);
