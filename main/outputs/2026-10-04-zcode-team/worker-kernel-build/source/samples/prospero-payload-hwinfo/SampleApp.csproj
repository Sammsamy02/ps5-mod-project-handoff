<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SharpProsperoRoot Condition="'$(SharpProsperoRoot)' == ''">$(SHARPPROSPERO_ROOT)</SharpProsperoRoot>
  </PropertyGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.Payload.props" />

  <PropertyGroup>
    <RootNamespace>SampleApp</RootNamespace>
    <AssemblyName>SampleApp</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ProsperoKernelSprx>libkernel_sys.sprx</ProsperoKernelSprx>
  </PropertyGroup>

  <ItemGroup>
    <DirectPInvoke Include="libkernel_sys" />
  </ItemGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.Payload.targets" />

</Project>
