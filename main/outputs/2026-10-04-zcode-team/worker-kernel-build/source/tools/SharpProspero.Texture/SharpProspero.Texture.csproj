<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>SharpProspero.Texture</RootNamespace>
    <AssemblyName>SharpProspero.Texture</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Opt-in bridge for internal-visibility usage. Off by default; a run that needs it sets
       EnableInternalTests=true on the MSBuild command line. -->
  <Import Project="../../build/InternalBridge.props"
          Condition="'$(EnableInternalTests)' == 'true' and Exists('../../build/InternalBridge.props')" />

</Project>
