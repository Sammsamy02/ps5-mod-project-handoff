      "methodClassName": "Pad"
    },
    {
      "name": "UserService",
      "header": "user_service.h",
      "library": "libSceUserService",
      "methodClassName": "UserService"
    },
    {
      "name": "SystemService",
      "header": "system_service.h",
      "library": "libSceSystemService",
      "methodClassName": "SystemService"
    },
    {
      "name": "AudioOut",
      "header": "audioout.h",
      "library": "libSceAudioOut",
      "methodClassName": "AudioOut"
    },
    {
      "name": "Agc",
      "header": "agc.h",
      "library": "libSceAgc",
      "methodClassName": "Agc"
    }
  ]
