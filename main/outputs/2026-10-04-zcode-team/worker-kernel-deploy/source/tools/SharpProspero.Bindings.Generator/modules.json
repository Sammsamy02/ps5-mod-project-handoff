{
  "defaultConfig": [
    "generate-macro-bindings",
    "generate-file-scoped-namespaces",
    "generate-helper-types",
    "exclude-empty-records"
  ],
  "defaultAdditionalArgs": [
    "-std=c11",
    "-Wno-pragma-once-outside-header",
    "-Wno-microsoft-enum-forward-reference"
