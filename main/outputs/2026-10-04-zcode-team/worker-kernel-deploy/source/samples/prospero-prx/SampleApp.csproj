<Project Sdk="Microsoft.NET.Sdk">

  <!-- Point SharpProsperoRoot at the SDK checkout, or set the SHARPPROSPERO_ROOT environment
       variable. Run `doctor.ps1` in the SDK to check the setup. -->
  <PropertyGroup>
    <SharpProsperoRoot Condition="'$(SharpProsperoRoot)' == ''">$(SHARPPROSPERO_ROOT)</SharpProsperoRoot>
  </PropertyGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.App.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>SampleApp</RootNamespace>
    <AssemblyName>SampleApp</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Build a relocatable library module (SampleApp.prx) instead of an eboot. -->
    <ProsperoModuleKind>Prx</ProsperoModuleKind>
  </PropertyGroup>

  <!-- The functions this library exports, matching the [UnmanagedCallersOnly] entry-point names. -->
  <ItemGroup>
    <ProsperoExportSymbol Include="sampleAdd" />
    <ProsperoExportSymbol Include="sampleVersion" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SharpProsperoRoot)\src\SharpProspero\SharpProspero.csproj" />
  </ItemGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.App.targets" />

</Project>
