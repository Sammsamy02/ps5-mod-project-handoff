<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <SharpProsperoRoot Condition="'$(SharpProsperoRoot) == ''">$(SHARPPROSPERO_ROOT)</SharpProsperoRoot>
  </PropertyGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.Payload.props" />

  <PropertyGroup>
    <RootNamespace>LauncherApp</RootNamespace>
    <AssemblyName>LauncherApp</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SharpProsperoRoot)\src\SharpProspero\SharpProspero.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <ProsperoKernelSprx>libkernel_sys.sprx</ProsperoKernelSprx>
    <ProsperoReturnOnExit>true</ProsperoReturnOnExit>
  </PropertyGroup>
  <ItemGroup>
    <ProsperoSprx Include="libSceLibcInternal" />
    <ProsperoSprx Include="libSceSystemService" />
  </ItemGroup>

  <Import Project="$(SharpProsperoRoot)\build\Prospero.Payload.targets" />

</Project>
