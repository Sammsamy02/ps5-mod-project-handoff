+// r7: verify ONE site of a window — readable-span coverage gate FIRST (the
+// read-risk rule: never dereference an uncovered span; igf7 exercised this
+// path with A refusal=uncovered and no dereference), then a full byte-loop
+// compare with r6's exact mismatch diagnostics (mm_off + live bytes 0..1).
+// Returns covered && matched.
+static bool anchor_site_verify(uint32_t length, const unsigned char *bytes,
+                               const AnchorSite &site,
+                               const lmf::OsVmMapping *mappings, size_t count)
+{
+    const uint64_t rt = kCandidateBase + site.vaddr;
+    bool covered = false;
+    for (size_t i = 0; i < count; ++i) {
+        if ((mappings[i].protection & kVmProtRead) != 0 &&
+            mappings[i].start <= rt && rt + length <= mappings[i].end) {
+            covered = true;
+            break;
+        }
+    }
+    ::diagnostic_event(site.tag_covered, covered ? 1u : 0u);
+    if (!covered) return false;
+    const unsigned char *p = reinterpret_cast<const unsigned char *>(rt);
+    uint32_t mismatch_at = 0xffffffffu;
+    for (uint32_t i = 0; i < length; ++i)
+        if (p[i] != bytes[i]) { mismatch_at = i; break; }
+    const bool matched = mismatch_at == 0xffffffffu;
+    ::diagnostic_event(site.tag_match, matched ? 1u : 0u);
+    if (!matched) {
+        ::diagnostic_event(site.tag_mm_off, mismatch_at);
+        ::diagnostic_event(site.tag_live,
+                           (uint32_t)p[mismatch_at < 4 ? mismatch_at : 0] |
+                               ((uint32_t)p[mismatch_at < 4 ? mismatch_at + 1 : 1] << 8));
+    }
+    return matched;
+}
