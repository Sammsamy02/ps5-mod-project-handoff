{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://translation-core.local/schemas/game-profile.v1.schema.json",
  "title": "game-profile v1 — L3 game-build profile of the adapter system",
  "description": "Machine-readable profile of ONE game build (title, engine, addresses, memory geometry, API surface, mod requirements) that any L1 compat runtime or L2 engine adapter consumes. Every fact carries a provenance class: 'in-game-observed' (validated on the live console), 're-verified' (offline RE on the sha-pinned image, multi-channel/cross-worker), or 'host-derived' (computed on the host from pinned sources without target execution). Generators must recompute hashes and address arithmetic from the cited sources; they must never invent values.",
  "type": "object",
  "required": [
    "profile_format",
    "profile_kind",
    "schema_id",
    "schema_version",
    "profile_id",
    "generated",
    "identity",
    "engine",
    "addresses",
    "memory_geometry",
    "api_surface",
    "mod_requirements",
    "runtime_facts",
    "provenance_classes",
    "sources",
    "unresolved",
    "readiness"
  ],
  "properties": {
    "profile_format": { "const": 1 },
    "profile_kind": { "const": "game-build-profile" },
    "schema_id": { "const": "game-profile" },
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9-]+-game-profile-v[0-9]+$" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "generator": {
      "type": "object",
      "required": ["path", "inputs_manifest"],
      "properties": {
        "path": { "type": "string" },
        "inputs_manifest": { "type": "string", "description": "Path (relative to the profile) of the machine-readable inputs/validation record emitted alongside this profile." },
        "regenerate_command": { "type": "string" }
      }
    },
    "layer_model": {
      "type": "object",
      "description": "Where this profile sits in the universal-translator stack.",
      "required": ["l1", "l2", "l3"],
      "properties": {
        "l1": { "type": "string", "description": "Compat runtime layer — consumes this profile; owns hooks/leases/capture." },
        "l2": { "type": "string", "description": "Engine adapter layer — consumes engine.key_structures to bind engine services." },
        "l3": { "type": "string", "description": "This artifact: the per-game-build facts both lower layers resolve against." }
      }
    },
    "identity": {
      "type": "object",
      "required": ["title", "title_id", "executable", "image_sha256", "target", "pointer_size"],
      "properties": {
        "title": { "type": "string" },
        "title_id": { "type": "string" },
        "executable": { "type": "string" },
        "executable_console_path": { "type": "string" },
        "image_bytes": { "type": "integer", "minimum": 0 },
        "image_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sha_provenance": { "type": "string", "description": "Which source the hash was recomputed from at generation time." },
        "target": { "type": "string" },
        "pointer_size": { "const": 8 },
        "elf": {
          "type": "object",
          "properties": {
            "e_type": { "type": "integer" },
            "e_machine": { "type": "integer" },
            "e_phnum": { "type": "integer" },
            "e_entry": { "type": "integer" },
            "sections": { "type": "string", "description": "e.g. 'none' — SHT-less Sony layout" },
            "symbols": { "type": "string" }
          }
        },
        "build_id_staged_layout": { "type": ["string", "null"], "description": "The binding-contract staged-layout build_id; null = unresolved (the capture sha256 is NOT this value)." }
      }
    },
    "engine": {
      "type": "object",
      "required": ["family", "version", "key_structures"],
      "properties": {
        "family": { "const": "Unreal" },
        "version": {
          "type": "object",
          "required": ["major", "minor"],
          "properties": {
            "major": { "type": "integer" },
            "minor": { "type": "integer" },
            "patch": { "type": ["integer", "null"] },
            "revision": { "type": ["string", "null"] },
            "resolution": { "type": "string" },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" },
            "note": { "type": "string" }
          }
        },
        "version_override": {
          "type": "object",
          "description": "How the runtime pins the version on this target (settings-served engine_version slot).",
          "properties": {
            "settings_section": { "type": "string" },
            "value": { "type": "string" },
            "effect": { "type": "string" },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" }
          }
        },
        "key_structures": {
          "type": "object",
          "description": "Engine structures/functions the L2 adapter binds. Each entry carries file-vaddr label(s), offsets, and provenance.",
          "properties": {
            "FNamePool": { "$ref": "#/$defs/structure" },
            "FName_ctor_wchar": { "$ref": "#/$defs/function" },
            "GUObjectArray": { "$ref": "#/$defs/structure" },
            "GMalloc": { "$ref": "#/$defs/structure" },
            "StaticConstructObjectInternal": { "$ref": "#/$defs/function" },
            "UGameEngine_Tick": { "$ref": "#/$defs/function" }
          }
        }
      }
    },
    "addresses": {
      "type": "object",
      "required": ["translation_rule", "seed_slots"],
      "properties": {
        "translation_rule": {
          "type": "object",
          "required": ["rule", "slide", "provenance_class"],
          "properties": {
            "rule": { "type": "string", "description": "runtime = linked_file_vaddr + slide" },
            "slide": { "type": "integer", "minimum": 0 },
            "file_offset_rule": { "type": "string", "description": "file byte offset mapping, e.g. vaddr+0x4000 for LOAD0/1" },
            "runtime_image_extent": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
            "file_image_extent_vaddr": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" },
            "evidence": { "type": "string" }
          }
        },
        "seed_slots": {
          "type": "array",
          "description": "The profiled seed-address slots. Each answers 'what is at runtime X' with label, runtime value, segment class, consumers and provenance.",
          "items": {
            "type": "object",
            "required": ["slot_id", "name", "kind", "label", "runtime", "segment", "address_class", "provenance_class"],
            "properties": {
              "slot_id": { "type": "integer" },
              "name": { "type": "string" },
              "kind": { "enum": ["data", "code", "data-validator-anchor"] },
              "label": { "type": "string", "description": "file/linked vaddr, hex" },
              "runtime": { "type": "string", "description": "label + slide, hex" },
              "segment": { "type": "string" },
              "address_class": { "enum": ["data-readable", "exec-only-call-only", "refused"] },
              "read_policy": { "type": "string" },
              "semantic": { "type": "string" },
              "consumer": { "type": "string" },
              "derivation_summary": { "type": "string" },
              "ingame_evidence": { "type": ["string", "null"] },
              "provenance_class": { "$ref": "#/$defs/provenanceClass" },
              "sources": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "support_constants": {
          "type": "array",
          "description": "Address constants that are never seeded/bound but gate or document slots (validators, pinned non-seeded functions).",
          "items": { "$ref": "#/$defs/supportConstant" }
        },
        "runtime_examples": {
          "type": "array",
          "description": "Observed in-game runtime values that exemplify the translation rule and geometry, with the run they came from.",
          "items": {
            "type": "object",
            "required": ["name", "value", "run", "provenance_class"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": ["string", "integer"] },
              "run": { "type": "string" },
              "provenance_class": { "$ref": "#/$defs/provenanceClass" }
            }
          }
        }
      }
    },
    "memory_geometry": {
      "type": "object",
      "required": ["page_size", "segments", "owned_read_policy"],
      "properties": {
        "page_size": { "const": 16384 },
        "segments": {
          "type": "array",
          "description": "PT_LOAD table (phdr index, vaddr range, protection, BSS) in file vaddr space with derived runtime ranges.",
          "items": {
            "type": "object",
            "required": ["phdr_index", "flags", "vaddr_start", "memsz_end"],
            "properties": {
              "phdr_index": { "type": "integer" },
              "flags": { "type": "string" },
              "p_flags": { "type": "integer" },
              "vaddr_start": { "type": "integer" },
              "memsz_end": { "type": "integer" },
              "filesz_end": { "type": "integer" },
              "bss_bytes": { "type": "integer" },
              "rt_start": { "type": "integer" },
              "rt_end_memsz": { "type": "integer" },
              "rt_page_rounded": { "type": "array", "items": { "type": "integer" } },
              "igf3_observed_spans": {
                "type": "array",
                "description": "Kernel-reported VMMAP fragments over this segment's runtime range (in-game observed, igf3 clean walk).",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": { "type": "integer" },
                    "end": { "type": "integer" },
                    "prot": { "type": "integer" }
                  }
                }
              }
            }
          }
        },
        "vmmap_observed": {
          "type": "object",
          "description": "Observed VMMAP classes and quirks (split segments, missing LOAD8 coverage, giant-span churn).",
          "properties": {
            "source": { "type": "string" },
            "spans_intersecting_image": { "type": "integer" },
            "readable_spans_intersecting_image": { "type": "integer" },
            "notes": { "type": "array", "items": { "type": "string" } },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" }
          }
        },
        "seed_address_classes": {
          "type": "object",
          "description": "The classify_seed_address boundary table (file-vaddr ranges -> data-readable / exec-only-call-only / refused).",
          "properties": {
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file_vaddr_range", "class"],
                "properties": {
                  "file_vaddr_range": { "type": "array", "items": { "type": "integer" } },
                  "class": { "enum": ["data-readable", "exec-only-call-only", "refused"] },
                  "segment": { "type": "string" }
                }
              }
            },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" }
          }
        },
        "owned_read_policy": {
          "type": "object",
          "description": "What a consumer may read/call and how coverage is proven (the launch-9/igf4/igf6-earned rules).",
          "required": ["rules"],
          "properties": {
            "rules": { "type": "array", "items": { "type": "string" } },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" }
          }
        },
        "known_false_claims": {
          "type": "array",
          "description": "Retracted arithmetic/geometric claims that consumers must never re-derive.",
          "items": {
            "type": "object",
            "required": ["claim", "status"],
            "properties": {
              "claim": { "type": "string" },
              "status": { "type": "string" },
              "why_wrong": { "type": "string" }
            }
          }
        },
        "consumer_read_risks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "api_surface": {
      "type": "object",
      "description": "What the composed runtime exposes to mods (the Lua API inventory the L1 runtime provides).",
      "required": ["provided", "dynamic_reflection"],
      "properties": {
        "provided": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["api", "status"],
            "properties": {
              "api": { "type": "string" },
              "status": { "type": "string" },
              "definition": { "type": "string" },
              "used_by_mod": { "type": "boolean" }
            }
          }
        },
        "dynamic_reflection": { "type": "string" },
        "provenance_class": { "$ref": "#/$defs/provenanceClass" },
        "source": { "type": "string" }
      }
    },
    "mod_requirements": {
      "type": "object",
      "description": "What THIS game's mod tree requires from the runtime (loadlist manifest, input map, settings gates).",
      "required": ["loadlist"],
      "properties": {
        "loadlist": {
          "type": "object",
          "required": ["format", "title", "framework", "mods", "files"],
          "properties": {
            "format": { "type": "string" },
            "title": { "type": "string" },
            "engine": { "type": "string" },
            "framework": { "type": "string" },
            "mods": { "type": "array", "items": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" } } } },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["role", "path", "size_bytes"],
                "properties": { "role": { "type": "string" }, "path": { "type": "string" }, "size_bytes": { "type": "integer" } }
              }
            },
            "source": { "type": "string" },
            "sha256_16": { "type": "string" },
            "variants": { "type": "object", "description": "Other verified loadlist variants and why they differ." }
          }
        },
        "input_map": {
          "type": "object",
          "properties": {
            "profile_file": { "type": "string" },
            "bindings": { "type": "object", "description": "pad button -> UE4SS key" },
            "note": { "type": "string" },
            "provenance_class": { "$ref": "#/$defs/provenanceClass" }
          }
        },
        "mod_api_usage": {
          "type": "array",
          "description": "The mod's load-time API calls (all must resolve at load).",
          "items": { "type": "object", "required": ["api"], "properties": { "api": { "type": "string" }, "used_at": { "type": "string" } } }
        },
        "oracle_line": { "type": "string", "description": "The UE4SS.log line that proves the mod executed." },
        "settings_gates": { "type": "array", "items": { "type": "string" } },
        "provenance_class": { "$ref": "#/$defs/provenanceClass" }
      }
    },
    "runtime_facts": {
      "type": "object",
      "description": "The L1 runtime's own capture/lease/spanpub constants plus their observed in-game values.",
      "required": ["constants", "observed_runs"],
      "properties": {
        "constants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "provenance_class"],
            "properties": {
              "name": { "type": "string" },
              "value": { "type": ["integer", "string"] },
              "meaning": { "type": "string" },
              "provenance_class": { "$ref": "#/$defs/provenanceClass" },
              "source": { "type": "string" }
            }
          }
        },
        "observed_runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run", "pid", "values"],
            "properties": {
              "run": { "type": "string" },
              "pid": { "type": "integer" },
              "values": { "type": "object" },
              "verdict": { "type": "string" },
              "provenance_class": { "$ref": "#/$defs/provenanceClass" }
            }
          }
        }
      }
    },
    "provenance_classes": {
      "type": "object",
      "description": "Definitions of the provenance enum used by every fact.",
      "required": ["in-game-observed", "re-verified", "host-derived"],
      "properties": {
        "in-game-observed": { "type": "string" },
        "re-verified": { "type": "string" },
        "host-derived": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "role"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "role": { "type": "string" },
          "sha256": { "type": ["string", "null"] },
          "sha256_16": { "type": ["string", "null"] },
          "recomputed_at_generation": { "type": "boolean" }
        }
      }
    },
    "unresolved": { "type": "array", "items": { "type": "string" } },
    "readiness": {
      "type": "object",
      "required": ["profile_ready"],
      "properties": {
        "profile_ready": { "type": "boolean" },
        "static_survey_ready": { "type": "boolean" },
        "runtime_binding_ready": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "provenanceClass": {
      "enum": ["in-game-observed", "re-verified", "host-derived"],
      "description": "in-game-observed: validated on the live console (reads, run diag, anchors). re-verified: offline RE on the sha-pinned image via >=2 independent channels (capstone/lief + Ghidra, or cross-worker agreement). host-derived: computed on the host from pinned sources without target execution (phdr parse, arithmetic, static survey endpoints, fixtures)."
    },
    "structure": {
      "type": "object",
      "required": ["label", "runtime", "provenance_class"],
      "properties": {
        "label": { "type": "string" },
        "runtime": { "type": "string" },
        "offsets": { "type": "object" },
        "constants": { "type": "object" },
        "functions": { "type": "object" },
        "semantics": { "type": "object" },
        "validators": { "type": "object" },
        "corroboration": { "type": "object" },
        "semantic": { "type": "string" },
        "consumer": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "provenance_class": { "$ref": "#/$defs/provenanceClass" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "function": {
      "type": "object",
      "required": ["label", "runtime", "provenance_class"],
      "properties": {
        "label": { "type": "string" },
        "runtime": { "type": "string" },
        "signature": { "type": "string" },
        "prologue_bytes": { "type": "string" },
        "binding": { "type": "string" },
        "semantic": { "type": "string" },
        "consumer": { "type": "string" },
        "derivation_summary": { "type": "string" },
        "corroboration": { "type": "object" },
        "notes": { "type": "array", "items": { "type": "string" } },
        "provenance_class": { "$ref": "#/$defs/provenanceClass" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "supportConstant": {
      "type": "object",
      "required": ["name", "label", "runtime", "provenance_class"],
      "properties": {
        "name": { "type": "string" },
        "label": { "type": "string" },
        "runtime": { "type": "string" },
        "role": { "type": "string" },
        "segment": { "type": "string" },
        "provenance_class": { "$ref": "#/$defs/provenanceClass" },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
