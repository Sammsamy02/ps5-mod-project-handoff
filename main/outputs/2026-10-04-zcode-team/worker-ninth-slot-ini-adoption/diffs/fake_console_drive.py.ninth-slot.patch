+def _cc1_stage():
+    def rec(seq, exp, **fields):
+        r = {"marker": "modbridge.ingamefacts", "schema": 1, "build_id": cb.CC1["build_id"],
+             "seq": seq, "exp": exp, "rc": 0, "errno": 0}
