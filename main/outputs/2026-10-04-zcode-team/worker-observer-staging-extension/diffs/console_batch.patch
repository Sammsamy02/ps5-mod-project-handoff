+                            "console backup ploader.ini.$TAG.bak")
+        if rc2 != 0:
+            return "FAIL", "could not write console .bak backup — STOP (never edit without a rollback artifact)"
+        return "PASS", "%s pre-image secured (%d bytes, sha %s) + .bak written" % (label, n, sha[:12])
+    return fn
