@@ -572,6 +572,22 @@
 	struct timespec n;
 	clock_gettime(CLOCK_MONOTONIC, &n);
 	return (n.tv_sec - g_t0.tv_sec) * 1000L + (n.tv_nsec - g_t0.tv_nsec) / 1000000L;
+}
+
+#define STEPLOG_PATH "/data/plugins/ploader.log"
+
+// append-only step log: injection timing that survives reboot (toasts do not)
+static void steplog(const char* fmt, ...) {
+	FILE* f = fopen(STEPLOG_PATH, "a");
+	if (!f)
+		return;
+	fprintf(f, "[%ldms] ", now_ms());
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(f, fmt, ap);
+	va_end(ap);
+	fputc('\n', f);
+	fclose(f);
 }
 
