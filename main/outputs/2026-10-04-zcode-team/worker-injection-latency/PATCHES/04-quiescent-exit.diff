 			app_info_t info = { 0 };
 			if (sceKernelGetAppInfo(pid, &info) != 0 || info.title_id[0] == '\0')
@@ -786,6 +789,7 @@
 
 			plugin_entry_t* entry = find_entry(info.title_id);
 			if (!entry || entry->injected) continue;
