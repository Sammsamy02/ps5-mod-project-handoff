+-- LOCAL TEST TOOLING ONLY. Not a mod, never autoloaded or deployed.
+-- Loading this file only returns a runner. Every engine call needs new({enabled=true}),
+-- explicit case/risk selection, fixture context and an independent thread witness.
+-- A caller-provided "engine" label is not authenticated engine evidence.
+local M = {}
+local SCHEMA = "modbridge.ue4ss-conformance/1"
+local SUITE = "townfall-itemspawner-v1-17-surfaces-v1"
+local RELEASE = "f586043a1ca5708113e8ee31532d6396cbb0866daeae473722dd8880b6559658"
+local HELPER = "5a8f6609e555eee4a535f51d21fcdef768ac654bf4d4abe283c719b1c12215a7"
+local NULL = {}
+local ARRAY = {}
+local BINDINGS = {"RegisterKeyBind", "RegisterLoadMapPreHook", "print", "ExecuteInGameThread",
+    "FindFirstOf", "require", "CreateInvalidObject", "FindAllOf", "StaticFindObject",
+    "FName", "StaticConstructObject", "FText", "LoadAsset"}
+local KEY_NAMES = {"F7", "UP_ARROW", "DOWN_ARROW", "RETURN", "LEFT_ARROW", "RIGHT_ARROW"}
+local Session = {}; Session.__index = Session
+local cases = {}
+
+local function encode(v, active)
+    if v == NULL or v == nil then return "null" end
+    local kind = type(v)
+    if kind == "boolean" then return v and "true" or "false" end
+    if kind == "number" then
+        assert(v == v and v ~= math.huge and v ~= -math.huge, "nonfinite JSON number")
+        return string.format("%.17g", v)
+    end
+    if kind == "string" then
+        return '"' .. v:gsub('[%z\1-\31\\"]', function(c)
+            local escaped = {['"']='\\"', ['\\']='\\\\', ['\n']='\\n', ['\r']='\\r', ['\t']='\\t'}
+            return escaped[c] or string.format("\\u%04x", string.byte(c))
+        end) .. '"'
+    end
+    assert(kind == "table", "unserializable result: " .. kind)
+    active = active or {}; assert(not active[v], "cyclic JSON result"); active[v] = true
+    local length, count, array = #v, 0, true
+    for k in pairs(v) do count=count+1; if type(k) ~= "number" or k < 1 or k % 1 ~= 0 or k > length then array=false end end
+    array = array and count == length and (length > 0 or getmetatable(v)==ARRAY)
+    local parts = {}
+    if array then for i=1,length do parts[#parts+1]=encode(v[i], active) end
+    else
+        local keys = {}; for k in pairs(v) do assert(type(k)=="string", "JSON object key must be string"); keys[#keys+1]=k end
+        table.sort(keys)
+        for _,k in ipairs(keys) do parts[#parts+1]=encode(k, active)..":"..encode(v[k], active) end
+    end
+    active[v] = nil
+    return (array and "[" or "{") .. table.concat(parts, ",") .. (array and "]" or "}")
+end
+local function same(a,b) return encode(a) == encode(b) end
+local function stop(status, reason, value, failure)
+    error({status=status, reason=reason, value=value, failure=failure}, 0)
+end
+local function need(condition, label) if not condition then stop("skipped", "missing explicit context: " .. label) end end
+local function check(condition, label) if not condition then error(label, 0) end end
+local function number(v, name) check(type(v)=="number", name .. " must be numeric"); return v end
+local function xyz(v) return {X=number(v.X,"X"),Y=number(v.Y,"Y"),Z=number(v.Z,"Z")} end
+local function xy(v) return {X=number(v.X,"X"),Y=number(v.Y,"Y")} end
+local function add(id, api, permission, bindings, run, options)
+    local c = {id=id,api=api,order=#cases+1,permission=permission,bindings=bindings,run=run}
+    for k,v in pairs(options or {}) do c[k]=v end
+    cases[#cases+1]=c
+end
+function Session:object(v, label)
+    local kind=type(v)
+    need(kind=="userdata" or (self.cfg.evidence=="host-fixture" and kind=="table"), label .. " (native userdata required for engine evidence)")
+    return v
+end
+function Session:result_object(v, label)
+    local kind=type(v)
+    check(kind=="userdata" or (self.cfg.evidence=="host-fixture" and kind=="table"), "unexpected native result: "..label.." ("..kind..")")
+    return v
+end
+function Session:valid(v) return v:IsValid() == true end
+function Session:guard()
+    local callback = self.cfg.thread_guard
+    if type(callback) ~= "function" then return nil, "independent game-thread witness unavailable" end
+    local ok, witness = pcall(callback)
+    if not ok then return nil, "game-thread witness error: " .. tostring(witness) end
+    if type(witness) ~= "table" or witness.in_game_thread ~= true then return nil, "game-thread witness did not prove this thread" end
+    local equal = witness.thread_id ~= nil and witness.thread_id == witness.known_game_thread_id
+    if not equal then return nil, "native thread identity not independently matched" end
+    if self.cfg.evidence == "engine" and (witness.kind ~= "independent-native" or type(witness.proof_id) ~= "string" or witness.proof_id == "") then
+        return nil, "Lua booleans/dispatch assumptions are not independent native thread proof"
+    end
+    return {verified=self.cfg.evidence=="engine",in_game_thread=true}, {
+        thread_id=tostring(witness.thread_id),known_game_thread_id=tostring(witness.known_game_thread_id),proof_id=tostring(witness.proof_id or "host-fixture")}
+end
+function Session:callback_guard()
+    local guard, why = self:guard()
+    return guard, guard and nil or why
+end
+function Session:cleanup(kind, context, object)
+    local ok, witness = pcall(self.cfg.cleanup, kind, context, object)
+    if not ok then stop("failed", nil, {cleanup_verified=false}, "cleanup failed: " .. tostring(witness)) end
+    if type(witness) ~= "table" or witness.ok ~= true or witness.verified ~= true then
+        stop("observed", "cleanup receipt pending", {cleanup_verified=false})
+    end
+    if self.cfg.evidence=="engine" and (witness.evidence~="engine" or type(witness.proof_id)~="string" or witness.proof_id=="") then
+        stop("observed", "independent engine cleanup receipt pending", {cleanup_verified=false})
+    end
+end
