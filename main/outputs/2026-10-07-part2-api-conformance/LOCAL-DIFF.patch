+        guard=prior and prior.guard or self.current_guard or {verified=false,in_game_thread=false}}
+    local volatile=prior and prior.volatile or self.current_volatile
+    if volatile then r.volatile=volatile end
+    self.results[spec.id]=r
+end
+function Session:invoke(spec, callback)
+    local ok,value,status,reason=pcall(callback,self)
+    if ok then self:record(spec,value,status,reason)
+    elseif type(value)=="table" and value.status then self:record(spec,value.value,value.status,value.reason,value.failure)
+    else self:record(spec,nil,"failed",nil,tostring(value)) end
+end
+function Session:run()
+    assert(not self.started and not self.closed,"single-use session")
+    self.started=true
+    for _,spec in ipairs(cases) do
+        self.current_guard=nil;self.current_volatile=nil
+        local why,unavailable
+        if not self.selected[spec.id] then why="case not selected"
+        elseif self.cfg.allow[spec.permission]~=true then why="permission disabled: "..spec.permission
+        else
+            for _,name in ipairs(spec.bindings) do if rawget(_G,name)==nil then unavailable=name;break end end
+            if not unavailable then
+                local guard,detail=self:guard()
+                if not guard then why=detail else self.current_guard=guard;self.current_volatile=detail end
+            end
+        end
+        if unavailable then self:record(spec,nil,"unavailable","binding unavailable: "..unavailable)
+        elseif why then self:record(spec,nil,"skipped",why)
+        else self:invoke(spec,spec.run) end
+    end
+    return self
+end
+function Session:finish()
+    assert(self.started and not self.closed,"run once, then finish once after approved manual observations")
+    for _,spec in ipairs(cases) do
+        local r=self.results[spec.id]
+        if spec.finish and (r.status=="observed" or r.status=="fixture-pass" or r.status=="proved") then
+            -- No API is scheduled at finish; only callback/capture observations are finalized.
+            self.current_guard=r.guard;self.current_volatile=r.volatile
+            local ok,value=pcall(spec.finish,self)
+            if ok and value~=nil then self:record(spec,value)
+            elseif not ok then
+                if type(value)=="table" and value.status then self:record(spec,value.value,value.status,value.reason,value.failure)
+                else self:record(spec,nil,"failed",nil,tostring(value)) end
+            end
+        end
+    end
+    self.closed=true
+    local meta=self.cfg.metadata or {};local selected_ids=setmetatable({},ARRAY)
+    for _,spec in ipairs(cases) do if self.selected[spec.id] then selected_ids[#selected_ids+1]=spec.id end end
+    local att=meta.attestations or {}
+    if self.cfg.evidence~="engine" then att={real_engine=false,release_immutable=false,independent_thread_witness=false,controlled_object_context=false} end
+    local header={schema=SCHEMA,kind="run",suite_id=SUITE,run_id=meta.run_id or "unspecified",
+        side=self.cfg.side or "host",evidence=self.cfg.evidence,mod_release_sha256=meta.mod_release_sha256 or RELEASE,
+        helper_sha256=meta.helper_sha256 or HELPER,script_sha256=meta.script_sha256 or NULL,
+        game_id=meta.game_id or "Townfall",content_build=meta.content_build or "unspecified",
+        scenario_id=meta.scenario_id or "unspecified",context_id=meta.context_id or "unspecified",
+        runtime_build=meta.runtime_build or "unspecified",runtime_sha256=meta.runtime_sha256 or NULL,
+        game_binary_sha256=meta.game_binary_sha256 or NULL,
+        attestations=att,selected_case_ids=selected_ids}
+    self.cfg.emit(encode(header))
+    for _,name in ipairs(BINDINGS) do
+        local object=rawget(_G,name)
+        self.cfg.emit(encode({schema=SCHEMA,kind="binding",name=name,binding_present=object~=nil,lua_type=type(object),behavior_proved=false}))
+    end
+    local status_counts={}
+    for _,spec in ipairs(cases) do
+        local result=self.results[spec.id];status_counts[result.status]=(status_counts[result.status] or 0)+1
+        self.cfg.emit(encode(result))
+    end
+    self.cfg.emit(encode({schema=SCHEMA,kind="end",complete=true,case_count=#cases,status_counts=status_counts}))
+    return self.results
+end
+function M.new(cfg)
+    if type(cfg)~="table" or cfg.enabled~=true then return nil,"disabled" end
+    if type(cfg.emit)~="function" then return nil,"explicit JSONL sink required" end
+    if cfg.evidence~="engine" and cfg.evidence~="host-fixture" then return nil,"evidence must be engine or host-fixture" end
+    if cfg.evidence=="engine" then
+        local att=cfg.metadata and cfg.metadata.attestations or {}
+        for _,flag in ipairs({"real_engine","release_immutable","independent_thread_witness","controlled_object_context"}) do
+            if att[flag]~=true then return nil,"missing independently receipted attestation: "..flag end
+        end
+    end
+    cfg.allow=cfg.allow or {};cfg.context=cfg.context or {}
+    local selected,known={},{}
+    for _,spec in ipairs(cases) do known[spec.id]=true;if cfg.select==nil then selected[spec.id]=true end end
+    for _,id in ipairs(cfg.select or {}) do if not known[id] or selected[id] then return nil,"unknown/duplicate case selection" end;selected[id]=true end
+    return setmetatable({cfg=cfg,ctx=cfg.context,selected=selected,results={},key_counts={},key_order={},map_count=0,dispatch_count=0},Session)
+end
+function M.case_plan()
+    local plan={}
+    for _,spec in ipairs(cases) do plan[#plan+1]={id=spec.id,api=spec.api,order=spec.order,permission=spec.permission,
+        requires_thread=true,covers=spec.covers or setmetatable({},ARRAY)} end
+    return plan
+end
+M.bindings=BINDINGS;M.schema=SCHEMA;M.suite_id=SUITE;M.json=encode
+return M
