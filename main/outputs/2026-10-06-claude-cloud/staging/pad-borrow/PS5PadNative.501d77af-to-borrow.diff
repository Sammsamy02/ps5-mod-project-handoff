+        return handle; // Keep the original ALREADY_OPENED as the recorded open failure.
+    }
+    diagnostic_event("pad_open_class",1u);
+    borrowed_handle.store(game_handle,std::memory_order_release);
+    return game_handle;
+}
+int close_owned(int handle) {
+    int expected=handle;
+    if (borrowed_handle.compare_exchange_strong(expected,-1,std::memory_order_acq_rel)) return 0;
