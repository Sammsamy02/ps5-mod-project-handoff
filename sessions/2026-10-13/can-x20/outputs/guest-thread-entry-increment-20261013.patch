+bool GuestPeModule::owns_executable_address(const void* address) const noexcept
+{
+    if (!attached_ || !address || !load_.image || !load_.impl) return false;
+    const uint64_t base = reinterpret_cast<uint64_t>(load_.image);
+    const uint64_t candidate = reinterpret_cast<uint64_t>(address);
+    if (candidate < base || candidate - base >= load_.image_size) return false;
+    const uint64_t rva = candidate - base;
+    for (const auto& range : load_.impl->executable_ranges)
+        if (rva >= range.begin && rva < range.end) return true;
+    return false;
+}
+
+GuestCallStatus GuestPeModule::invoke_thread_start(
+    void* start, void* argument, GuestTebView& teb, uint32_t* exit_code)
+{
+    if (!attached_) return GuestCallStatus::WrongState;
+    if (!teb.belongs_to(bank_) || !teb.on_owner_thread())
+        return GuestCallStatus::WrongThreadOrBank;
+    if (!exit_code || !owns_executable_address(start))
+        return GuestCallStatus::InvalidArguments;
+    try { (void)teb.refresh(); }
+    catch (const std::bad_alloc&) { return GuestCallStatus::TlsPreparationFailed; }
+    if (!segment_.enter(teb.address())) return GuestCallStatus::BackendRefused;
+    LeaveSegment leave(segment_);
+    ScopedGuestLastErrorBinding error_binding(teb.address());
+    *exit_code = static_cast<uint32_t>(cap13_win64_call1(
+        start, reinterpret_cast<uint64_t>(argument)));
+    return GuestCallStatus::Ok;
+}
+
 GuestPeLoad pe_prepare_guest(const void* file_bytes, size_t file_size,
                              ImportResolver& resolver, const LoadOptions& options,
                              StaticTlsBank& bank, GuestSegmentSwitch& segment)
