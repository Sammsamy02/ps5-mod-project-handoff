+            second_segment.allow_until = 1000;
+            check(cap13::pe_detach_guest_batch(pair, main_teb),
+                  "two-module batch detaches after worker tests");
+        }
+    }
+    std::printf("TOTAL: checks=%d failures=%d\n", checks, failures);
+    return failures ? 1 : 0;
+}
