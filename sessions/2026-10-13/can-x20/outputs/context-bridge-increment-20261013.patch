+// Context-bound guest -> host thunks. The trampoline supplies r10=context
+// and r11=SysV target. The Win64 guest arguments are shifted one SysV slot
+// right so the target sees context as its first parameter. Guest arguments
+// 6..8 occupy SysV stack slots; the frame reserves three such slots.
+.macro G2H_CONTEXT_THUNK n_guest
+    sub  rsp, 0xE8
+    movups [rsp + 0x030], xmm6
+    movups [rsp + 0x040], xmm7
+    movups [rsp + 0x050], xmm8
+    movups [rsp + 0x060], xmm9
+    movups [rsp + 0x070], xmm10
+    movups [rsp + 0x080], xmm11
+    movups [rsp + 0x090], xmm12
+    movups [rsp + 0x0A0], xmm13
+    movups [rsp + 0x0B0], xmm14
+    movups [rsp + 0x0C0], xmm15
+    mov  [rsp + 0x0D0], rsi
+    mov  [rsp + 0x0D8], rdi
+    mov  [rsp + 0x020], r10     // context lives in frame padding
+
+.if \n_guest > 5
+    mov  r10, [rsp + 0x118]     // guest a6 -> SysV stack arg 7
+    mov  [rsp + 0x000], r10
+.endif
+.if \n_guest > 6
+    mov  r10, [rsp + 0x120]     // guest a7 -> SysV stack arg 8
+    mov  [rsp + 0x008], r10
+.endif
+.if \n_guest > 7
+    mov  r10, [rsp + 0x128]     // guest a8 -> SysV stack arg 9
+    mov  [rsp + 0x010], r10
+.endif
