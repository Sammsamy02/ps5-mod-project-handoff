+    mov  rcx, r8                // SysV a4 = guest a3
+    mov  r8,  r9                // SysV a5 = guest a4
+.if \n_guest > 4
+    mov  r9, [rsp + 0x110]     // SysV a6 = guest stack a5
+.endif
+    mov  rdi, [rsp + 0x020]     // SysV a1 = context; rdx already guest a2
+    call r11
+
+    movups xmm6,  [rsp + 0x030]
+    movups xmm7,  [rsp + 0x040]
+    movups xmm8,  [rsp + 0x050]
+    movups xmm9,  [rsp + 0x060]
+    movups xmm10, [rsp + 0x070]
+    movups xmm11, [rsp + 0x080]
+    movups xmm12, [rsp + 0x090]
+    movups xmm13, [rsp + 0x0A0]
+    movups xmm14, [rsp + 0x0B0]
+    movups xmm15, [rsp + 0x0C0]
+    mov  rsi, [rsp + 0x0D0]
+    mov  rdi, [rsp + 0x0D8]
+    add  rsp, 0xE8
