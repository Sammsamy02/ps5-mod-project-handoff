+// These handle only integer/pointer guest arguments and integer/pointer
+// returns. The caller must refuse unsupported signature classes.
+void cap13_g2h_context_thunk0();
+void cap13_g2h_context_thunk1();
+void cap13_g2h_context_thunk2();
+void cap13_g2h_context_thunk3();
+void cap13_g2h_context_thunk4();
+void cap13_g2h_context_thunk5();
