+// A context-bound per-export trampoline. It is stamped in writable memory,
+// then the caller must make that memory executable before publication.
+struct ContextBridgeTramp
+{
+    uint8_t bytes[32];
+};
+static_assert(sizeof(ContextBridgeTramp) == 32, "context trampoline must stay 32 bytes");
+
+// movabs r10, context; movabs r11, SysV target; movabs rax, thunk; jmp rax.
+inline void bridge_stamp_context_tramp(void* dst_writable, void* context,
+                                       void* sysv_target, const void* shared_thunk)
+{
+    uint8_t t[32] = {0x49, 0xBA, 0, 0, 0, 0, 0, 0, 0, 0,
+                     0x49, 0xBB, 0, 0, 0, 0, 0, 0, 0, 0,
+                     0x48, 0xB8, 0, 0, 0, 0, 0, 0, 0, 0,
+                     0xFF, 0xE0};
+    const uint64_t ctx = reinterpret_cast<uint64_t>(context);
+    const uint64_t tgt = reinterpret_cast<uint64_t>(sysv_target);
+    const uint64_t thk = reinterpret_cast<uint64_t>(shared_thunk);
+    std::memcpy(t + 2, &ctx, 8);
+    std::memcpy(t + 12, &tgt, 8);
+    std::memcpy(t + 22, &thk, 8);
+    std::memcpy(dst_writable, t, sizeof(t));
+}
+
+inline const void* bridge_select_context_thunk(uint32_t guest_integer_args)
+{
+    switch (guest_integer_args)
+    {
+        case 0: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk0);
+        case 1: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk1);
+        case 2: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk2);
+        case 3: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk3);
+        case 4: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk4);
+        case 5: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk5);
+        case 6: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk6);
+        case 7: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk7);
+        case 8: return reinterpret_cast<const void*>(&cap13_g2h_context_thunk8);
+        default: return nullptr;
+    }
+}
+
 } // namespace cap13
 
