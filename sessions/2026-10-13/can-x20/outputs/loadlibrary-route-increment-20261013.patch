+struct LoadState
+{
+    cap13::WinApiShim* shim = nullptr;
+    int owner = 0;
+    int calls = 0;
+    std::string last_name;
+};
+cap13::WinModule load_pe(void* user, const char* name)
+{
+    auto& state = *static_cast<LoadState*>(user);
+    ++state.calls;
+    state.last_name = name;
+    if (state.last_name == "late.dll")
+    {
+        if (state.shim->register_mapped_module("/mods/late.dll",
+                reinterpret_cast<void*>(0x600), mapped_lookup, &state.owner))
+            return reinterpret_cast<void*>(0x600);
+    }
+    // A callback returning a different registered module must not substitute it.
+    return reinterpret_cast<void*>(0x500);
+}
