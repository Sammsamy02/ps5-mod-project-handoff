+// One-shot attach into a stable caller-owned result, followed by queued
+// worker activation. Failed attachment aborts queued thread objects. The
+// manager must already be bound to the shim and outlive the result's workers.
+bool pe_attach_guest_batch_managed(
+    const std::vector<GuestPeBatchInput>& inputs, WinApiShim& shim,
+    const LoadOptions& options, StaticTlsBank& bank, GuestTebView& teb,
