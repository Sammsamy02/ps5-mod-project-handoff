+static void impl_InitializeCriticalSection(WinApiShim::Impl* m, void* guest)
+{
+    try
+    {
+        if (m->critical_sections.initialize(guest, 0, 0)) return;
+    }
+    catch (...) {}
+    m->fail_closed("InitializeCriticalSection invalid guest object");
+}
+
+static uint32_t impl_InitializeCriticalSectionEx(
+    WinApiShim::Impl* m, void* guest, uint32_t spin_count, uint32_t flags)
+{
+    try
+    {
+        if (m->critical_sections.initialize(guest, spin_count, flags))
+            return 1;
+    }
+    catch (...) {}
+    win32_set_last_error(ERROR_INVALID_PARAMETER);
+    return 0;
+}
+
+static void impl_EnterCriticalSection(WinApiShim::Impl* m, void* guest)
+{
+    try
+    {
+        if (m->critical_sections.enter(guest)) return;
+    }
+    catch (...) {}
+    m->fail_closed("EnterCriticalSection invalid guest lifecycle");
+}
+
+static void impl_LeaveCriticalSection(WinApiShim::Impl* m, void* guest)
+{
+    try
+    {
+        if (m->critical_sections.leave(guest)) return;
+    }
+    catch (...) {}
+    m->fail_closed("LeaveCriticalSection unowned guest object");
+}
+
+static void impl_DeleteCriticalSection(WinApiShim::Impl* m, void* guest)
+{
+    try
+    {
+        if (m->critical_sections.erase(guest)) return;
+    }
+    catch (...) {}
+    m->fail_closed("DeleteCriticalSection owned or unknown guest object");
