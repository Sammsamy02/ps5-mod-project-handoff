+static uint32_t impl_VirtualProtect(WinApiShim::Impl* m, void* base,
+                                    size_t size, uint32_t protect,
+                                    void* old_protect)
+{
+    uint32_t error = ERROR_INVALID_PARAMETER;
+    const auto writer = [](void* user, void* destination,
+                           const void* source, size_t bytes) -> bool {
+        auto* impl = static_cast<WinApiShim::Impl*>(user);
+        return impl->owner->write_guest_bytes(destination, source, bytes);
+    };
+    if (!m->virtual_memory.protect(base, size, protect, old_protect,
+                                   writer, m, &error))
+    {
+        win32_set_last_error(error);
+        return 0;
+    }
+    return 1;
+}
