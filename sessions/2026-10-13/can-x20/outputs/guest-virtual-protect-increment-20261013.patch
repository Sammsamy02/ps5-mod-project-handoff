+inline bool GuestVirtualMemory::protect(void* base, size_t bytes,
+                                        uint32_t new_protect,
+                                        void* old_protect_output,
+                                        WriteGuest write_guest,
+                                        void* write_user, uint32_t* error)
+{
+    using namespace virtual_memory_detail;
+    if (error) *error = kInvalidParameter;
+    if (!base || !bytes || !old_protect_output || !write_guest ||
+        (new_protect != kReadOnly && new_protect != kReadWrite))
+        return false;
+    const long page_value = sysconf(_SC_PAGESIZE);
+    if (page_value <= 0) return false;
+    const size_t page = static_cast<size_t>(page_value);
+    if (bytes > SIZE_MAX - (page - 1)) return false;
+    const size_t length = ((bytes + page - 1) / page) * page;
+    std::lock_guard guard(mu_);
+    auto found = regions_.find(base);
+    if (found == regions_.end() || !found->second.committed ||
+        found->second.mapped != length)
+    {
+        if (error) *error = kInvalidAddress;
+        return false;
+    }
+    const uint32_t previous = found->second.protect;
+    if (!write_guest(write_user, old_protect_output,
+                     &previous, sizeof(previous)))
+    {
+        if (error) *error = kNoAccess;
+        return false;
+    }
+    if (previous == new_protect) return true;
+    if (previous == kReadWrite)
+    {
+        if (!writes_->remove(base))
+        {
+            if (error) *error = kInvalidAddress;
+            return false;
+        }
+        if (mprotect(base, length, PROT_READ) != 0)
+        {
+            writes_->add(base, base, length);
+            if (error) *error = kNotEnoughMemory;
+            return false;
+        }
+    }
+    else
+    {
+        if (mprotect(base, length, PROT_READ | PROT_WRITE) != 0)
+        {
+            if (error) *error = kNotEnoughMemory;
+            return false;
+        }
+        if (!writes_->add(base, base, length))
+        {
+            mprotect(base, length, PROT_READ);
+            if (error) *error = kNotEnoughMemory;
+            return false;
+        }
+    }
+    found->second.protect = new_protect;
+    return true;
+}
+
 } // namespace cap13
 #endif
