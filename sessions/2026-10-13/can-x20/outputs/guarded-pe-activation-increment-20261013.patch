+#!/usr/bin/env python3
+"""Compile and run guarded PE activation checks on the x64 Mac host."""
+from pathlib import Path
+import hashlib
+import subprocess
+
+root = Path(__file__).resolve().parents[1]
+stage = root.parent
+source = stage / "third_party/TrueFOV-upstream-winmm.dll"
+fixture = stage.parent / "cap13/FIXTURES/cap13-ue4ss-native-mod-FIXTURE.dll"
+fixture_hash = "acc201987edcee968a052ef889cb0e8bdcc5c5cd63fcdb4c0dda699cace51bce"
+upstream = stage.parent / "cg-max-ready-20261013-03/cap13/upstream-inputs"
+cases = [
+    (stage / "third_party/TrueFOV-upstream-winmm.dll",
+     "5f23eee1c7479e75699d26d339ea69269eb0da0c33fc9be4cd60957ee63302a3"),
+    (upstream / "ZeroCompanyMandoWardrobe-upstream-main.dll",
+     "821ecad6c9f7e61faa2a07b31c216475768b72c2066369d3b0b88f715b33a40c"),
+    (upstream / "TFWWorkbench-upstream-main.dll",
+     "24b05dc267dc6e9faa6cbcb4e85a8491733e0a86b86fbac92f5aa1a0950aa6ca"),
+    (upstream / "EventViewerMod-upstream-main.dll",
+     "83422a25fffd8d0d39c78fe001eac2fd169fc148858a5004ae3af52fd41544e0"),
+    (upstream / "KismetDebuggerMod-upstream-main.dll",
+     "4e7907661afe4bb49ebd1677b9e631410554b80ed9df1a9b3ea9e1bcd92a4aae"),
+]
+out = root / "tests/guarded-pe-activation-host"
+if hashlib.sha256(fixture.read_bytes()).hexdigest() != fixture_hash:
+    raise RuntimeError("synthetic fixture hash mismatch")
+subprocess.run([
+    "clang++", "-arch", "x86_64", "-std=c++17", "-O1", "-g", "-Wall", "-Wextra", "-Werror", "-pthread",
+    "-I" + str(root / "include"), "-I" + str(root / "src"),
+    str(root / "tests/guarded_pe_activation_test.cpp"),
+    str(root / "src/guest_pe_loader.cpp"),
+    str(root / "src/pe_loader.cpp"),
+    str(root / "src/pe_tls_registration.cpp"),
+    str(root / "src/static_tls_bank.cpp"),
+    str(root / "src/guest_teb_lifecycle.cpp"),
+    str(root / "src/win64_bridge.S"),
+    "-o", str(out),
+], check=True, timeout=30)
+for sample, expected in cases:
+    before = hashlib.sha256(sample.read_bytes()).hexdigest()
+    if before != expected:
+        raise RuntimeError(f"source hash mismatch: {sample}")
+    subprocess.run(["arch", "-x86_64", str(out), str(source), str(fixture),
+                    str(sample)], check=True, timeout=20)
+    after = hashlib.sha256(sample.read_bytes()).hexdigest()
+    if after != before:
+        raise RuntimeError(f"source changed: {sample}")
+    print(f"UNCHANGED {sample.name} sha256={after}", flush=True)
+if hashlib.sha256(fixture.read_bytes()).hexdigest() != fixture_hash:
+    raise RuntimeError("synthetic fixture changed")
